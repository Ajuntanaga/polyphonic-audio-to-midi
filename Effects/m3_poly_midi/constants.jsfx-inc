@init
M3_MAX_CANDIDATES = 85; // MIDI 24..108 inclusive
M3_MAX_HARMONICS = 8;
M3_MAX_VOICES = 8;
M3_MAX_EVENTS = 16;

// Fixed, non-overlapping regions in JSFX local memory.
M3_CONFIG_BASE = 0;
M3_CONDITION_BASE = 256;
M3_RATE_BASE = 512;
M3_RESONATOR_BASE = 4096;
M3_SALIENCE_BASE = 32768;
M3_SELECTION_BASE = 33792;
M3_M3_SCRATCH_BASE = 34048;
M3_VOICE_BASE = 34816;
M3_EVENT_BASE = 36864;
M3_TELEMETRY_A_BASE = 37888;
M3_TELEMETRY_B_BASE = 38912;
M3_UI_LOCAL_BASE = 39936;
M3_MEMORY_END = 40000;

// Eight strings, low to high: G#1 C2 E2 G#2 C3 E3 G#3 C4.
M3_M3_OPEN_0 = 32;
M3_M3_OPEN_1 = 36;
M3_M3_OPEN_2 = 40;
M3_M3_OPEN_3 = 44;
M3_M3_OPEN_4 = 48;
M3_M3_OPEN_5 = 52;
M3_M3_OPEN_6 = 56;

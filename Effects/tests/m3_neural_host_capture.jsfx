desc:M3 Neural Host MIDI Observer
options:gmem=m3_neural_host_v1
in_pin:left
in_pin:right
out_pin:left
out_pin:right

@init
ext_noinit=1;

@block
i=0;
phase=gmem[18];
phase>0 ? (gmem[4]+=samplesblock;gmem[5]+=1;);
while(midirecv(offset,status,note,velocity)) (
  phase>0 ? (
    count=floor(gmem[10]);
    count<32768 ? (
      cell=16384+6*count;
      gmem[cell]=phase;
      gmem[cell+1]=gmem[1]+offset;
      gmem[cell+2]=offset;
      gmem[cell+3]=status;
      gmem[cell+4]=note;
      gmem[cell+5]=velocity;
      gmem[10]=count+1;
    ) : gmem[11]=1;
    kind=status & 240;
    kind==144 && velocity>0 ? (
      gmem[100+note]==0 ? gmem[20]+=1;
      gmem[100+note]=1;
    );
    kind==128 || (kind==144 && velocity==0) ? (
      gmem[100+note]>0 ? gmem[20]-=1;
      gmem[100+note]=0;
    );
  );
  midisend(offset,status,note,velocity);
);

@sample
phase>0 ? (
  peak=max(abs(spl0),abs(spl1));
  peak==peak && peak<1000000000000 ? (
    gmem[15]=max(gmem[15],peak);
  ) : gmem[14]=1;
  i<1024 ? (
    error=max(abs(spl0-gmem[4096+i]),abs(spl1-gmem[5120+i]));
    gmem[12]=max(gmem[12],error);
    gmem[13]+=1;
    error>0 ? gmem[17]+=1;
  ) : gmem[11]=1;
);
i+=1;

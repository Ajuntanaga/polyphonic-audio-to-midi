desc:ajuntanaga/M3 Polyphonic MIDI - Core Tests
tags:test MIDI analysis
options:gmem=m3_poly_midi_tests_v1
slider1:0<0,2,1{48 kHz,44.1 kHz,96 kHz}>Bounded resonator test rate
slider2:0<0,67,1{4101 G#1,4102 E2 Fast,4103 A4 +35c,4104 Missing Fundamental,4105 Silence,4106 Clipping,5101 E2 Ghosts,5102 E2+B2,5103 G#1+C2+E2,5104 Eight Opens,5105 Quiet True Note,5106 Three-Voice Cap,6101 Open Equivalence,6102 Selection Equivalence,6103 17 kHz Alias,6104 21 kHz Alias,6105 Work Bound,6106 Rate Guards,7101 M3 Opens,7102 Open Voicing,7103 Impossible Chromatic,7104 Feasible Four Notes,7105 Below Range,7106 General Bypass,8101 Below Threshold,8102 One Note-On,8103 Dropout,8104 One Note-Off,8105 Replacement Order,8106 Eight Active,8107 Release All,8108 Overflow Priority,8109 Same Pitch,8110 Fixed Velocity,8111 Dynamic Velocity,9101 Channel 1 Note-On,9102 Channel 16 Note-Off,9103 Offset Bounds,9104 Rate Cleanup,9105 Stop Cleanup,9106 Panic Cleanup,9107 No Duplicate On,9108 Input Select,9109 Mode Bounds,10101 Odd Snapshot,10102 Changed Snapshot,10103 Eight-Note Snapshot,10104 Invalid Input Fault,10105 Schema-Only State,10106 Unsupported Channels,12101 Weak Shared Fifth,12102 Independent Fifth,12103 Real Octave,12104 Short Attack Gap,12105 Sparse Attack Reset,12106 Release Tail Bridge,12107 Fundamental Peak Gate,12108 General Alias Gate,12109 General Response Profile,12110 Chord Attack Bridge,12111 Low-Energy Guard,12112 Confirmed Octave Guard,12113 Interference Plateau,12114 Active Voice Limit,12115 Low Octave Energy Gate,12116 M3 Fundamental Peak,12117 M3 Low-String Guard,12118 General Missing Fundamental}>Bounded detector test case
slider3:2<0,3,1{32,64,128,256}>Lifecycle test block size
in_pin:none
out_pin:none

import ../m3_poly_midi/constants.jsfx-inc
import ../m3_poly_midi/pitch_math.jsfx-inc
import ../m3_poly_midi/conditioning.jsfx-inc
import ../m3_poly_midi/resonator_bank.jsfx-inc
import ../m3_poly_midi/salience_selector.jsfx-inc
import ../m3_poly_midi/m3_profile.jsfx-inc
import ../m3_poly_midi/lifecycle.jsfx-inc
import ../m3_poly_midi/midi_emitter.jsfx-inc
import ../m3_poly_midi/telemetry_ui.jsfx-inc

@init
M3_TEST_MAGIC = 0x4D335431;
M3_TEST_REFERENCE_BANK_BASE = 50000;
M3_TEST_REFERENCE_SALIENCE_BASE = 56000;
M3_TEST_REFERENCE_SELECTION_BASE = 57000;
M3_TEST_RATE_NOTE_BASE = 58000;
M3_TEST_RATE_GAIN_BASE = 58008;
M3_TEST_RATE_PHASE_BASE = 58016;
M3_TEST_PROFILE_OPEN_BASE = 58100;
M3_TEST_PROFILE_NOTE_BASE = 58108;
M3_TEST_LIFECYCLE_RESPONSE_BASE = 58200;
M3_TEST_MIDI_ENCODE_BASE = 58216;
M3_TEST_BOUNDS_BASE = 58224;
M3_TEST_TELEMETRY_SOURCE_BASE = 58300;
M3_TEST_TELEMETRY_UI_BASE = 58364;
M3_TEST_SERIALIZATION_BASE = 58432;
M3_TEST_REALTIME_MAX_CONFIDENCE_BASE = 59000;
M3_TEST_REALTIME_EIGHT_PHASE_BASE = 59200;
M3_TEST_REALTIME_EIGHT_STEP_BASE = 59208;
M3_TEST_REALTIME_EIGHT_ON_BASE = 59216;
M3_TEST_REALTIME_EIGHT_SALIENCE_BASE = 59224;

function m3_test_near(id, actual, expected, tolerance) local(delta) (
  gmem[2] += 1;
  delta = abs(actual - expected);
  (!m3_isfinite(actual) || delta > tolerance) && gmem[3] == 0 ? (
    gmem[1] = -1;
    gmem[3] = id;
    gmem[4] = actual;
    gmem[5] = expected;
  );
);

function m3_test_lte(id, actual, maximum) (
  gmem[2] += 1;
  (!m3_isfinite(actual) || actual > maximum) && gmem[3] == 0 ? (
    gmem[1] = -1;
    gmem[3] = id;
    gmem[4] = actual;
    gmem[5] = maximum;
  );
);

function m3_test_gte(id, actual, minimum) (
  gmem[2] += 1;
  (!m3_isfinite(actual) || actual < minimum) && gmem[3] == 0 ? (
    gmem[1] = -1;
    gmem[3] = id;
    gmem[4] = actual;
    gmem[5] = minimum;
  );
);

function m3_test_condition_rate(test_sr)
local(base, count, y, phase, phase_step, x, input_energy, output_energy, gain_db) (
  base = M3_CONDITION_BASE;

  m3_condition_init(base, test_sr);
  count = floor(0.5 * test_sr);
  y = 0;
  loop(count,
    y = m3_condition_process(base, 1);
  );
  m3_test_lte(3101, abs(y), 0.001);

  m3_condition_init(base, test_sr);
  phase = 0;
  phase_step = 2 * $pi * 51.9131 / test_sr;
  count = floor(0.25 * test_sr);
  loop(count,
    x = sin(phase);
    m3_condition_process(base, x);
    phase += phase_step;
    phase >= 2 * $pi ? phase -= 2 * $pi;
  );
  input_energy = 0;
  output_energy = 0;
  count = floor(0.5 * test_sr);
  loop(count,
    x = sin(phase);
    y = m3_condition_process(base, x);
    input_energy += x * x;
    output_energy += y * y;
    phase += phase_step;
    phase >= 2 * $pi ? phase -= 2 * $pi;
  );
  gain_db = 10 * log10(
    max(output_energy, 0.000000000001) /
    max(input_energy, 0.000000000001)
  );
  m3_test_gte(3102, gain_db, -0.5);

  m3_condition_init(base, test_sr);
  y = m3_condition_process(base, 10 ^ 31);
  m3_test_near(3103, abs(y) + abs(base[15] - 1), 0, 0.000001);

  m3_condition_init(base, test_sr);
  m3_condition_process(base, 1);
  count = floor(0.25 * test_sr);
  loop(count,
    m3_condition_process(base, 0);
  );
  m3_test_gte(3104, base[14], 0.36);

  m3_condition_init(base, test_sr);
  count = floor(2 * test_sr);
  loop(count,
    m3_condition_process(base, 0);
  );
  m3_test_lte(3105, 10 * log10(max(base[12], 0.000000000001)), -100);
);

function m3_test_best_note(bank_base, salience_base)
local(min_note, candidate_count, candidate, last_candidate, best_note,
      best_score, score) (
  min_note = bank_base[1];
  candidate_count = bank_base[4];
  candidate = max(0, bank_base[10]);
  last_candidate = min(candidate_count - 1, bank_base[11]);
  best_note = min_note + candidate;
  best_score = -1;
  loop(max(0, last_candidate - candidate + 1),
    score = salience_base[candidate];
    score > best_score ? (
      best_score = score;
      best_note = min_note + candidate;
    );
    candidate += 1;
  );
  test_best_score = best_score;
  best_note;
);

function m3_test_bank_tone(test_sr, note, cents, duration, missing_fundamental,
                           test_min_note, test_max_note)
local(frequency, phase, phase_step, sample_index, sample_count, attack_samples,
      attack, sample, best_note) (
  m3_bank_init(
    M3_RESONATOR_BASE,
    test_sr,
    test_min_note,
    test_max_note,
    440
  );
  frequency = m3_midi_to_hz(note, 440) * 2 ^ (cents / 1200);
  phase = 0;
  phase_step = 2 * $pi * frequency / test_sr;
  sample_index = 0;
  sample_count = floor(duration * test_sr);
  attack_samples = max(1, floor(0.005 * test_sr));
  loop(sample_count,
    attack = sample_index < attack_samples
           ? 0.5 - 0.5 * cos($pi * sample_index / attack_samples)
           : 1;
    missing_fundamental
      ? sample = attack * 0.18 * (
          sin(2 * phase) + sin(3 * phase) + sin(4 * phase) +
          sin(5 * phase) + sin(6 * phase)
        )
      : sample = attack * 0.8 * sin(phase);
    m3_bank_process(M3_RESONATOR_BASE, sample);
    phase += phase_step;
    phase >= 2 * $pi ? phase -= 2 * $pi;
    sample_index += 1;
  );
  M3_SALIENCE_BASE[128] = 0.20;
  M3_SALIENCE_BASE[129] = 0;
  m3_salience_update(M3_RESONATOR_BASE, M3_SALIENCE_BASE, 0.000000000001);
  best_note = m3_test_best_note(M3_RESONATOR_BASE, M3_SALIENCE_BASE);
  best_note;
);

function m3_test_realtime_source_noise()
local(value) (
  value = floor(m3_test_realtime_source_seed);
  value ^= value << 13;
  value ^= value >> 17;
  value ^= value << 5;
  value &= 0x7FFFFFFF;
  m3_test_realtime_source_seed = max(1, value);
  m3_test_realtime_source_seed / 1073741824 - 1;
);

function m3_test_realtime_select_m3(test_sr, block_size, threshold)
local(signal_present, selected_count, test_min_note, test_max_note) (
  test_min_note = floor(M3_RESONATOR_BASE[8]);
  test_max_note = floor(M3_RESONATOR_BASE[9]);
  signal_present = m3_host_signal_present(M3_CONDITION_BASE[10]);
  signal_present ? (
    m3_general_acquisition_samples = min(
      test_sr,
      m3_general_acquisition_samples + block_size
    );
    selected_count = m3_select_voices(
      M3_RESONATOR_BASE,
      M3_SALIENCE_BASE,
      test_min_note,
      test_max_note - test_min_note + 1,
      threshold,
      M3_MAX_VOICES,
      440,
      M3_SELECTION_M3_LOCAL_ENERGY_RATIO,
      0,
      block_size,
      test_sr,
      M3_SELECTION_BASE
    );
    m3_general_acquisition_samples <
      M3_SELECTION_M3_ACQUISITION_SECONDS * test_sr ? (
      selected_count = 0;
      m3_zero(M3_SELECTION_BASE, M3_SELECTION_RESULT_WORDS);
    );
    selected_count = m3_profile_filter_selected(
      M3_PROFILE_MODE_M3,
      M3_SELECTION_BASE,
      selected_count,
      M3_MAX_VOICES,
      24,
      M3_CONFIG_BASE + M3_PROFILE_NOTE_WORK_OFFSET,
      M3_M3_SCRATCH_BASE
    );
  ) : (
    m3_general_acquisition_samples = 0;
    selected_count = 0;
    m3_zero(M3_SELECTION_BASE, M3_SELECTION_RESULT_WORDS);
    m3_zero(
      M3_SALIENCE_BASE + M3_SELECTION_SMOOTHED_ENERGY_OFFSET,
      M3_MAX_CANDIDATES
    );
  );
  selected_count;
);

function m3_test_realtime_configure_m3(block_size) (
  m3_lifecycle_attack_hysteresis = 1;
  m3_lifecycle_attack_bridge_samples = 2 * block_size;
  m3_lifecycle_attack_evidence_step_samples = block_size;
  m3_lifecycle_min_attack_energy = 0;
  m3_lifecycle_general_octave_guard = 0;
  m3_lifecycle_m3_low_string_guard = 1;
  m3_lifecycle_m3_octave_confirmation = 1;
  m3_lifecycle_m3_low_open_fast_attack = 1;
  m3_lifecycle_reserve_lower_attacks = 0;
  m3_lifecycle_max_active_voices = M3_MAX_VOICES;
  m3_lifecycle_attack_admission = 1;
);

function m3_test_realtime_single_on_error(
  test_sr, target_note, enforce_latency
)
local(block_size, onset_samples, attack_samples, signal_samples,
      total_samples, block_count, block_index, sample_index, block_sample,
      phase, phase_step, envelope, position, source, harmonic,
      conditioned, selected_count, selection_index, selection_cell,
      e2_candidate, e2_score, max_e2_score, max_e2_confidence,
      selected_e2_blocks, response_base, event_count, event_index, event,
      on_count, wrong_on_count, absolute_sample, note, max_wrong_confidence,
      max_wrong_note, open_index, open_energy, max_open_fundamental,
      max_selected_count, first_on_sample, latency_limit_samples,
      latency_error) (
  block_size = 128;
  onset_samples = max(1, floor(0.100 * test_sr + 0.5));
  attack_samples = max(1, floor(0.005 * test_sr + 0.5));
  signal_samples = max(1, floor(0.300 * test_sr + 0.5));
  total_samples = onset_samples + signal_samples;
  block_count = floor((total_samples + block_size - 1) / block_size);

  m3_profile_load(M3_CONFIG_BASE + M3_PROFILE_OPEN_OFFSET);
  m3_host_reset_detector(test_sr, 32, 84, 440);
  m3_test_realtime_configure_m3(block_size);
  response_base = M3_TEST_LIFECYCLE_RESPONSE_BASE;
  m3_lifecycle_response_for_profile(
    M3_PROFILE_MODE_M3,
    0,
    test_sr,
    0.20,
    response_base
  );

  sample_index = 0;
  absolute_sample = 0;
  phase = 0;
  target_note = floor(m3_clamp(target_note, 32, 84) + 0.5);
  enforce_latency = enforce_latency >= 0.5;
  phase_step = 2 * $pi * m3_midi_to_hz(target_note, 440) / test_sr;
  max_e2_score = 0;
  max_e2_confidence = 0;
  selected_e2_blocks = 0;
  on_count = 0;
  wrong_on_count = 0;
  max_selected_count = 0;
  first_on_sample = -1;
  m3_zero(M3_TEST_REALTIME_MAX_CONFIDENCE_BASE, 128);

  block_index = 0;
  loop(block_count,
    M3_SALIENCE_BASE[M3_SALIENCE_BASE_THRESHOLD_OFFSET] = 0.20;
    M3_SALIENCE_BASE[M3_SALIENCE_CLIPPED_OFFSET] =
      M3_CONDITION_BASE[14] > 0.01;
    m3_salience_update(
      M3_RESONATOR_BASE,
      M3_SALIENCE_BASE,
      M3_CONDITION_BASE[12]
    );
    e2_candidate = target_note - M3_RESONATOR_BASE[1];
    e2_score = M3_SALIENCE_BASE[e2_candidate];
    max_e2_score = max(max_e2_score, e2_score);

    selected_count = m3_test_realtime_select_m3(
      test_sr,
      block_size,
      M3_SALIENCE_BASE[M3_SALIENCE_EFFECTIVE_THRESHOLD_OFFSET]
    );
    max_selected_count = max(max_selected_count, selected_count);
    selection_index = 0;
    loop(selected_count,
      selection_cell = M3_SELECTION_BASE +
                       selection_index * M3_SELECTION_CELL_SIZE;
      M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[selection_cell[0]] = max(
        M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[selection_cell[0]],
        selection_cell[1]
      );
      selection_cell[0] == target_note ? (
        max_e2_confidence = max(max_e2_confidence, selection_cell[1]);
        selected_e2_blocks += 1;
      );
      selection_index += 1;
    );

    event_count = m3_lifecycle_update(
      M3_VOICE_BASE,
      M3_EVENT_BASE,
      M3_SELECTION_BASE,
      selected_count,
      absolute_sample,
      0,
      response_base[M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET],
      response_base[M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET],
      response_base[M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET],
      response_base[M3_LIFECYCLE_ON_THRESHOLD_OFFSET],
      response_base[M3_LIFECYCLE_OFF_THRESHOLD_OFFSET],
      M3_VELOCITY_MODE_FIXED,
      100
    );
    event_index = 0;
    loop(event_count,
      event = m3_lifecycle_event_cell(M3_EVENT_BASE, event_index);
      event[M3_EVENT_TYPE_OFFSET] == M3_EVENT_TYPE_ON ? (
        on_count < 8 ? gmem[22 + on_count] =
          event[M3_EVENT_NOTE_OFFSET] * 10 +
          M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[event[M3_EVENT_NOTE_OFFSET]];
        on_count += 1;
        event[M3_EVENT_NOTE_OFFSET] != target_note ? (
          wrong_on_count += 1;
        ) : (
          first_on_sample < 0 ? first_on_sample = absolute_sample +
            event[M3_EVENT_SAMPLE_OFFSET];
        );
      );
      event_index += 1;
    );

    block_sample = 0;
    loop(block_size,
      sample_index < onset_samples ? (
        source = 0;
      ) : (
        position = sample_index - onset_samples;
        envelope = position < attack_samples
          ? 0.5 - 0.5 * cos($pi * position / attack_samples)
          : 1;
        source = 0;
        harmonic = 1;
        loop(8,
          source += sin(harmonic * phase) / harmonic;
          harmonic += 1;
        );
        source *= 0.25 * envelope;
        phase += phase_step;
        phase >= 2 * $pi ? phase -= 2 * $pi;
      );
      conditioned = m3_condition_process(M3_CONDITION_BASE, source);
      m3_bank_process(M3_RESONATOR_BASE, conditioned);
      sample_index += 1;
      block_sample += 1;
    );
    absolute_sample += block_size;
    block_index += 1;
  );

  target_note == 40 ? (
    gmem[16] = max_e2_score;
    gmem[17] = max_e2_confidence;
    gmem[18] = response_base[M3_LIFECYCLE_ON_THRESHOLD_OFFSET];
    gmem[19] = selected_e2_blocks;
    gmem[20] = on_count;
    gmem[21] = wrong_on_count;
    gmem[62] = max_selected_count;
  );
  max_wrong_confidence = 0;
  max_wrong_note = 0;
  note = 32;
  loop(53,
    note != target_note &&
    M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[note] > max_wrong_confidence ? (
      max_wrong_confidence = M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[note];
      max_wrong_note = note;
    );
    note += 1;
  );
  target_note == 40 ? (
    gmem[11] = max_wrong_note;
    gmem[12] = max_wrong_confidence;
  );
  max_open_fundamental = 0;
  open_index = 0;
  loop(8,
    note = 32 + 4 * open_index;
    open_energy = m3_bank_energy(
      M3_RESONATOR_BASE,
      note - M3_RESONATOR_BASE[1],
      0
    );
    max_open_fundamental = max(max_open_fundamental, open_energy);
    open_index += 1;
  );
  open_index = 0;
  loop(8,
    note = 32 + 4 * open_index;
    gmem[96 + open_index] = m3_bank_energy(
      M3_RESONATOR_BASE,
      note - M3_RESONATOR_BASE[1],
      0
    ) / max(0.000000000001, max_open_fundamental);
    open_index += 1;
  );
  latency_limit_samples = floor(
    (target_note == 40 ? 0.025 : target_note == 48 ? 0.045 : 0.050) *
      test_sr + 0.5
  );
  latency_error = enforce_latency && test_sr == 48000
    ? first_on_sample < onset_samples
      ? latency_limit_samples
      : max(0, first_on_sample - onset_samples - latency_limit_samples)
    : 0;
  abs(on_count - 1) + wrong_on_count + latency_error;
);

function m3_test_realtime_dyad_on_error(
  test_sr, first_target_note, second_target_note, second_gain_db,
  selection_threshold, source_case_id
)
local(block_size, onset_samples, attack_samples, signal_samples,
      total_samples, block_count, block_index, sample_index, block_sample,
      phase_e2, phase_b2, step_e2, step_b2, envelope, position, source,
      harmonic, voice_e2, voice_b2, gain_b2, conditioned, selected_count,
      selection_index, selection_cell, response_base, event_count,
      event_index, event, on_e2_count, on_b2_count, wrong_on_count,
      absolute_sample, note, max_wrong_confidence, max_wrong_note,
      candidate_e2, candidate_b2, candidate_b3, weighted_e2, weighted_b2,
      weighted_b3, diagnostic_index, diagnostic_cell, max_selected_count,
      hum_50_phase, hum_60_phase) (
  block_size = 128;
  onset_samples = max(1, floor(0.500 * test_sr + 0.5));
  attack_samples = max(1, floor(0.005 * test_sr + 0.5));
  signal_samples = max(1, floor(0.300 * test_sr + 0.5));
  total_samples = onset_samples + signal_samples;
  block_count = floor((total_samples + block_size - 1) / block_size);

  m3_profile_load(M3_CONFIG_BASE + M3_PROFILE_OPEN_OFFSET);
  m3_host_reset_detector(test_sr, 24, 108, 440);
  m3_test_realtime_configure_m3(block_size);
  selection_threshold = m3_clamp(selection_threshold, 0, 1);
  response_base = M3_TEST_LIFECYCLE_RESPONSE_BASE;
  m3_lifecycle_response_for_profile(
    M3_PROFILE_MODE_M3,
    0,
    test_sr,
    selection_threshold,
    response_base
  );

  sample_index = 0;
  absolute_sample = 0;
  phase_e2 = 0;
  phase_b2 = 0;
  first_target_note = floor(m3_clamp(first_target_note, 32, 84) + 0.5);
  second_target_note = floor(m3_clamp(second_target_note, 32, 84) + 0.5);
  step_e2 = 2 * $pi * m3_midi_to_hz(first_target_note, 440) / test_sr;
  step_b2 = 2 * $pi * m3_midi_to_hz(second_target_note, 440) / test_sr;
  gain_b2 = 10 ^ (second_gain_db / 20);
  m3_test_realtime_source_seed = 0x13579BDF ^ floor(source_case_id);
  hum_50_phase = 0;
  hum_60_phase = 0;
  on_e2_count = 0;
  on_b2_count = 0;
  wrong_on_count = 0;
  max_selected_count = 0;
  candidate_e2 = first_target_note - M3_RESONATOR_BASE[1];
  candidate_b2 = second_target_note - M3_RESONATOR_BASE[1];
  candidate_b3 = second_target_note + 12 - M3_RESONATOR_BASE[1];
  m3_zero(M3_TEST_REALTIME_MAX_CONFIDENCE_BASE, 128);

  block_index = 0;
  loop(block_count,
    M3_SALIENCE_BASE[M3_SALIENCE_BASE_THRESHOLD_OFFSET] =
      selection_threshold;
    M3_SALIENCE_BASE[M3_SALIENCE_CLIPPED_OFFSET] =
      M3_CONDITION_BASE[14] > 0.01;
    m3_salience_update(
      M3_RESONATOR_BASE,
      M3_SALIENCE_BASE,
      M3_CONDITION_BASE[12]
    );
    gmem[32] = max(gmem[32], M3_SALIENCE_BASE[candidate_e2]);
    gmem[33] = max(gmem[33], M3_SALIENCE_BASE[candidate_b2]);
    gmem[34] = max(gmem[34], M3_SALIENCE_BASE[candidate_b3]);
    selected_count = m3_test_realtime_select_m3(
      test_sr,
      block_size,
      M3_SALIENCE_BASE[M3_SALIENCE_EFFECTIVE_THRESHOLD_OFFSET]
    );
    max_selected_count = max(max_selected_count, selected_count);
    selection_index = 0;
    loop(selected_count,
      selection_cell = M3_SELECTION_BASE +
                       selection_index * M3_SELECTION_CELL_SIZE;
      M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[selection_cell[0]] = max(
        M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[selection_cell[0]],
        selection_cell[1]
      );
      selection_index += 1;
    );

    event_count = m3_lifecycle_update(
      M3_VOICE_BASE,
      M3_EVENT_BASE,
      M3_SELECTION_BASE,
      selected_count,
      absolute_sample,
      0,
      response_base[M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET],
      response_base[M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET],
      response_base[M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET],
      response_base[M3_LIFECYCLE_ON_THRESHOLD_OFFSET],
      response_base[M3_LIFECYCLE_OFF_THRESHOLD_OFFSET],
      M3_VELOCITY_MODE_FIXED,
      100
    );
    event_index = 0;
    loop(event_count,
      event = m3_lifecycle_event_cell(M3_EVENT_BASE, event_index);
      event[M3_EVENT_TYPE_OFFSET] == M3_EVENT_TYPE_ON ? (
        note = event[M3_EVENT_NOTE_OFFSET];
        note == first_target_note ? on_e2_count += 1 :
        note == second_target_note ? on_b2_count += 1 : (
          wrong_on_count == 0 ? (
            gmem[35] = absolute_sample;
            gmem[36] = M3_SALIENCE_BASE[candidate_e2];
            gmem[37] = M3_SALIENCE_BASE[candidate_b2];
            gmem[38] = M3_SALIENCE_BASE[candidate_b3];
            gmem[39] = selected_count;
            diagnostic_index = 0;
            loop(min(4, selected_count),
              diagnostic_cell = M3_SELECTION_BASE +
                                diagnostic_index * M3_SELECTION_CELL_SIZE;
              gmem[40 + diagnostic_index * 2] = diagnostic_cell[0];
              gmem[41 + diagnostic_index * 2] = diagnostic_cell[1];
              diagnostic_index += 1;
            );
            weighted_e2 = m3_selection_weighted_energy(
              M3_RESONATOR_BASE,
              candidate_e2
            );
            weighted_b2 = m3_selection_weighted_energy(
              M3_RESONATOR_BASE,
              candidate_b2
            );
            weighted_b3 = m3_selection_weighted_energy(
              M3_RESONATOR_BASE,
              candidate_b3
            );
            gmem[48] = m3_bank_energy(
              M3_RESONATOR_BASE,
              candidate_e2,
              0
            ) / max(0.000000000001, weighted_e2);
            gmem[49] = m3_bank_energy(
              M3_RESONATOR_BASE,
              candidate_b2,
              0
            ) / max(0.000000000001, weighted_b2);
            gmem[50] = m3_bank_energy(
              M3_RESONATOR_BASE,
              candidate_b3,
              0
            ) / max(0.000000000001, weighted_b3);
            gmem[51] = m3_bank_energy(
              M3_RESONATOR_BASE,
              candidate_e2,
              0
            );
            gmem[52] = m3_bank_energy(
              M3_RESONATOR_BASE,
              candidate_b2,
              0
            );
            gmem[53] = m3_bank_energy(
              M3_RESONATOR_BASE,
              candidate_b3,
              0
            );
            gmem[54] = weighted_e2;
            gmem[55] = weighted_b2;
            gmem[56] = weighted_b3;
            gmem[57] = M3_SALIENCE_BASE[
              M3_SALIENCE_EFFECTIVE_THRESHOLD_OFFSET
            ];
          );
          wrong_on_count += 1;
        );
      );
      event_index += 1;
    );

    block_sample = 0;
    loop(block_size,
      sample_index < onset_samples ? (
        source = 0;
      ) : (
        position = sample_index - onset_samples;
        envelope = position < attack_samples
          ? 0.5 - 0.5 * cos($pi * position / attack_samples)
          : 1;
        voice_e2 = 0;
        voice_b2 = 0;
        harmonic = 1;
        loop(8,
          voice_e2 += sin(harmonic * phase_e2) / harmonic;
          voice_b2 += sin(harmonic * phase_b2) / harmonic;
          harmonic += 1;
        );
        source = 0.125 * envelope * (voice_e2 + gain_b2 * voice_b2);
        phase_e2 += step_e2;
        phase_b2 += step_b2;
        phase_e2 >= 2 * $pi ? phase_e2 -= 2 * $pi;
        phase_b2 >= 2 * $pi ? phase_b2 -= 2 * $pi;
      );
      source += 0.000001 * m3_test_realtime_source_noise();
      source += 0.000001 * sin(hum_50_phase);
      source += 0.000001 * sin(hum_60_phase);
      hum_50_phase += 2 * $pi * 50 / max(1, test_sr);
      hum_60_phase += 2 * $pi * 60 / max(1, test_sr);
      hum_50_phase >= 2 * $pi ? hum_50_phase -= 2 * $pi;
      hum_60_phase >= 2 * $pi ? hum_60_phase -= 2 * $pi;
      conditioned = m3_condition_process(M3_CONDITION_BASE, source);
      m3_bank_process(M3_RESONATOR_BASE, conditioned);
      sample_index += 1;
      block_sample += 1;
    );
    absolute_sample += block_size;
    block_index += 1;
  );

  max_wrong_confidence = 0;
  max_wrong_note = 0;
  note = 32;
  loop(53,
    note != first_target_note && note != second_target_note &&
    M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[note] > max_wrong_confidence ? (
      max_wrong_confidence = M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[note];
      max_wrong_note = note;
    );
    note += 1;
  );
  gmem[24] = on_e2_count;
  gmem[25] = on_b2_count;
  gmem[26] = wrong_on_count;
  gmem[27] = max_wrong_note;
  gmem[28] = max_wrong_confidence;
  gmem[63] = max_selected_count;
  abs(on_e2_count - 1) + abs(on_b2_count - 1) + wrong_on_count;
);

function m3_test_realtime_eight_opens_error(test_sr)
local(block_size, onset_samples, attack_samples, signal_samples,
      total_samples, block_count, block_index, sample_index, block_sample,
      envelope, position, source, voice, voice_index, note, frequency, phase,
      harmonic, conditioned, selected_count, selection_index, selection_cell,
      response_base, event_count, event_index, event, absolute_sample,
      wrong_on_count, max_wrong_confidence, max_wrong_note,
      max_selected_count, error, max_open_fundamental, open_energy,
      wrong_candidate, wrong_weighted_energy, scan_candidate,
      max_candidate_fundamental) (
  block_size = 128;
  onset_samples = max(1, floor(0.100 * test_sr + 0.5));
  attack_samples = max(1, floor(0.005 * test_sr + 0.5));
  signal_samples = max(1, floor(0.300 * test_sr + 0.5));
  total_samples = onset_samples + signal_samples;
  block_count = floor((total_samples + block_size - 1) / block_size);

  m3_profile_load(M3_CONFIG_BASE + M3_PROFILE_OPEN_OFFSET);
  m3_host_reset_detector(test_sr, 32, 84, 440);
  m3_test_realtime_configure_m3(block_size);
  response_base = M3_TEST_LIFECYCLE_RESPONSE_BASE;
  m3_lifecycle_response_for_profile(
    M3_PROFILE_MODE_M3,
    0,
    test_sr,
    0.08,
    response_base
  );
  m3_zero(M3_TEST_REALTIME_MAX_CONFIDENCE_BASE, 128);
  m3_zero(M3_TEST_REALTIME_EIGHT_PHASE_BASE, 8);
  m3_zero(M3_TEST_REALTIME_EIGHT_ON_BASE, 8);
  m3_zero(M3_TEST_REALTIME_EIGHT_SALIENCE_BASE, 8);

  voice_index = 0;
  loop(8,
    note = 32 + 4 * voice_index;
    M3_TEST_REALTIME_EIGHT_STEP_BASE[voice_index] =
      2 * $pi * m3_midi_to_hz(note, 440) / test_sr;
    voice_index += 1;
  );
  sample_index = 0;
  absolute_sample = 0;
  wrong_on_count = 0;
  max_selected_count = 0;

  block_index = 0;
  loop(block_count,
    M3_SALIENCE_BASE[M3_SALIENCE_BASE_THRESHOLD_OFFSET] = 0.08;
    M3_SALIENCE_BASE[M3_SALIENCE_CLIPPED_OFFSET] =
      M3_CONDITION_BASE[14] > 0.01;
    m3_salience_update(
      M3_RESONATOR_BASE,
      M3_SALIENCE_BASE,
      M3_CONDITION_BASE[12]
    );
    voice_index = 0;
    loop(8,
      note = 32 + 4 * voice_index;
      M3_TEST_REALTIME_EIGHT_SALIENCE_BASE[voice_index] = max(
        M3_TEST_REALTIME_EIGHT_SALIENCE_BASE[voice_index],
        M3_SALIENCE_BASE[note - M3_RESONATOR_BASE[1]]
      );
      voice_index += 1;
    );

    selected_count = m3_test_realtime_select_m3(
      test_sr,
      block_size,
      M3_SALIENCE_BASE[M3_SALIENCE_EFFECTIVE_THRESHOLD_OFFSET]
    );
    max_selected_count = max(max_selected_count, selected_count);
    selection_index = 0;
    loop(selected_count,
      selection_cell = M3_SELECTION_BASE +
                       selection_index * M3_SELECTION_CELL_SIZE;
      note = selection_cell[0];
      M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[note] = max(
        M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[note],
        selection_cell[1]
      );
      selection_index += 1;
    );

    event_count = m3_lifecycle_update(
      M3_VOICE_BASE,
      M3_EVENT_BASE,
      M3_SELECTION_BASE,
      selected_count,
      absolute_sample,
      0,
      response_base[M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET],
      response_base[M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET],
      response_base[M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET],
      response_base[M3_LIFECYCLE_ON_THRESHOLD_OFFSET],
      response_base[M3_LIFECYCLE_OFF_THRESHOLD_OFFSET],
      M3_VELOCITY_MODE_FIXED,
      100
    );
    event_index = 0;
    loop(event_count,
      event = m3_lifecycle_event_cell(M3_EVENT_BASE, event_index);
      event[M3_EVENT_TYPE_OFFSET] == M3_EVENT_TYPE_ON ? (
        note = event[M3_EVENT_NOTE_OFFSET];
        note >= 32 && note <= 60 && (note - 32) % 4 == 0 ? (
          M3_TEST_REALTIME_EIGHT_ON_BASE[(note - 32) / 4] += 1;
        ) : (
          wrong_on_count == 0 ? (
            wrong_candidate = note - M3_RESONATOR_BASE[1];
            wrong_weighted_energy = m3_selection_weighted_energy(
              M3_RESONATOR_BASE,
              wrong_candidate
            );
            gmem[58] = m3_bank_energy(
              M3_RESONATOR_BASE,
              wrong_candidate,
              0
            );
            gmem[59] = wrong_weighted_energy;
            gmem[60] = gmem[58] /
              max(0.000000000001, wrong_weighted_energy);
            max_candidate_fundamental = 0;
            scan_candidate = 0;
            loop(53,
              max_candidate_fundamental = max(
                max_candidate_fundamental,
                m3_bank_energy(M3_RESONATOR_BASE, scan_candidate, 0)
              );
              scan_candidate += 1;
            );
            gmem[61] = gmem[58] /
              max(0.000000000001, max_candidate_fundamental);
          );
          wrong_on_count += 1;
        );
      );
      event_index += 1;
    );

    block_sample = 0;
    loop(block_size,
      sample_index < onset_samples ? (
        source = 0;
      ) : (
        position = sample_index - onset_samples;
        envelope = position < attack_samples
          ? 0.5 - 0.5 * cos($pi * position / attack_samples)
          : 1;
        source = 0;
        voice_index = 0;
        loop(8,
          note = 32 + 4 * voice_index;
          frequency = m3_midi_to_hz(note, 440);
          phase = M3_TEST_REALTIME_EIGHT_PHASE_BASE[voice_index];
          voice = 0;
          harmonic = 1;
          loop(8,
            harmonic * frequency < 0.45 * test_sr ? (
              voice += sin(harmonic * phase) / harmonic;
            );
            harmonic += 1;
          );
          source += voice;
          phase += M3_TEST_REALTIME_EIGHT_STEP_BASE[voice_index];
          phase >= 2 * $pi ? phase -= 2 * $pi;
          M3_TEST_REALTIME_EIGHT_PHASE_BASE[voice_index] = phase;
          voice_index += 1;
        );
        source *= 0.25 * envelope / 8;
      );
      conditioned = m3_condition_process(M3_CONDITION_BASE, source);
      m3_bank_process(M3_RESONATOR_BASE, conditioned);
      sample_index += 1;
      block_sample += 1;
    );
    absolute_sample += block_size;
    block_index += 1;
  );

  error = wrong_on_count;
  voice_index = 0;
  loop(8,
    error += abs(M3_TEST_REALTIME_EIGHT_ON_BASE[voice_index] - 1);
    gmem[64 + voice_index] =
      M3_TEST_REALTIME_EIGHT_SALIENCE_BASE[voice_index];
    note = 32 + 4 * voice_index;
    gmem[72 + voice_index] =
      M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[note];
    gmem[81 + voice_index] =
      M3_TEST_REALTIME_EIGHT_ON_BASE[voice_index];
    voice_index += 1;
  );
  max_wrong_confidence = 0;
  max_wrong_note = 0;
  note = 32;
  loop(53,
    !((note >= 32 && note <= 60 && (note - 32) % 4 == 0)) &&
    M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[note] > max_wrong_confidence ? (
      max_wrong_confidence = M3_TEST_REALTIME_MAX_CONFIDENCE_BASE[note];
      max_wrong_note = note;
    );
    note += 1;
  );
  gmem[80] = response_base[M3_LIFECYCLE_ON_THRESHOLD_OFFSET];
  gmem[89] = wrong_on_count;
  gmem[90] = max_wrong_note;
  gmem[91] = max_wrong_confidence;
  gmem[92] = max_selected_count;
  gmem[93] = M3_CONDITION_BASE[14];
  gmem[94] = M3_CONDITION_BASE[12];
  gmem[95] = selected_count;
  selection_index = 0;
  loop(8,
    selection_cell = M3_SELECTION_BASE +
                     selection_index * M3_SELECTION_CELL_SIZE;
    selection_index < selected_count ? (
      gmem[112 + selection_index * 2] = selection_cell[0];
      gmem[113 + selection_index * 2] = selection_cell[1];
    ) : (
      gmem[112 + selection_index * 2] = 0;
      gmem[113 + selection_index * 2] = 0;
    );
    selection_index += 1;
  );
  note = 32;
  loop(53,
    gmem[128 + note - 32] =
      M3_SALIENCE_BASE[note - M3_RESONATOR_BASE[1]];
    note += 1;
  );
  max_open_fundamental = 0;
  voice_index = 0;
  loop(8,
    note = 32 + 4 * voice_index;
    open_energy = m3_bank_energy(
      M3_RESONATOR_BASE,
      note - M3_RESONATOR_BASE[1],
      0
    );
    max_open_fundamental = max(max_open_fundamental, open_energy);
    voice_index += 1;
  );
  voice_index = 0;
  loop(8,
    note = 32 + 4 * voice_index;
    gmem[104 + voice_index] = m3_bank_energy(
      M3_RESONATOR_BASE,
      note - M3_RESONATOR_BASE[1],
      0
    ) / max(0.000000000001, max_open_fundamental);
    gmem[181 + voice_index] = m3_bank_energy(
      M3_RESONATOR_BASE,
      note - M3_RESONATOR_BASE[1],
      0
    ) / max(
      0.000000000001,
      m3_selection_weighted_energy(
        M3_RESONATOR_BASE,
        note - M3_RESONATOR_BASE[1]
      )
    );
    voice_index += 1;
  );
  note = 32;
  loop(53,
    gmem[192 + note - 32] = m3_bank_energy(
      M3_RESONATOR_BASE,
      note - M3_RESONATOR_BASE[1],
      0
    );
    note += 1;
  );
  error;
);

function m3_test_bank_silence(test_sr)
local(sample_count, best_note) (
  m3_bank_init(M3_RESONATOR_BASE, test_sr, 32, 32, 440);
  sample_count = floor(0.300 * test_sr);
  loop(sample_count,
    m3_bank_process(M3_RESONATOR_BASE, 0);
  );
  M3_SALIENCE_BASE[128] = 0.20;
  M3_SALIENCE_BASE[129] = 0;
  m3_salience_update(M3_RESONATOR_BASE, M3_SALIENCE_BASE, 0.000000000001);
  best_note = m3_test_best_note(M3_RESONATOR_BASE, M3_SALIENCE_BASE);
  m3_test_lte(4105, test_best_score, M3_SALIENCE_BASE[130]);
);

function m3_test_bank_clipped_impulse(test_sr)
local(sample_count, best_note, threshold_error, excess_score) (
  m3_bank_init(M3_RESONATOR_BASE, test_sr, 32, 32, 440);
  m3_bank_process(M3_RESONATOR_BASE, 1);
  sample_count = floor(0.300 * test_sr) - 1;
  loop(sample_count,
    m3_bank_process(M3_RESONATOR_BASE, 0);
  );
  M3_SALIENCE_BASE[128] = 0.20;
  M3_SALIENCE_BASE[129] = 1;
  m3_salience_update(M3_RESONATOR_BASE, M3_SALIENCE_BASE, 0.000000000001);
  best_note = m3_test_best_note(M3_RESONATOR_BASE, M3_SALIENCE_BASE);
  threshold_error = abs(M3_SALIENCE_BASE[130] - 0.28);
  excess_score = max(0, test_best_score - M3_SALIENCE_BASE[130]);
  m3_test_near(4106, threshold_error + excess_score, 0, 0.000001);
);

function m3_test_bank_case(test_sr, case_id) local(best_note) (
  case_id == 4101 ? (
    best_note = m3_test_bank_tone(test_sr, 32, 0, 0.300, 0, 32, 60);
    m3_test_near(
      4107,
      abs(M3_RESONATOR_BASE[1] - 31) +
      abs(M3_RESONATOR_BASE[2] - 61) +
      abs(M3_RESONATOR_BASE[8] - 32) +
      abs(M3_RESONATOR_BASE[9] - 60),
      0,
      0
    );
    m3_test_near(4101, best_note, 32, 0);
  );

  case_id == 4102 ? (
    best_note = m3_test_bank_tone(test_sr, 40, 0, 0.045, 0, 32, 52);
    gmem[13] = test_best_score;
    gmem[14] = M3_SALIENCE_BASE[40 - M3_RESONATOR_BASE[1]];
    gmem[31] = best_note;
    m3_test_near(
      4102,
      abs(best_note - 40) +
      m3_test_realtime_single_on_error(test_sr, 40, 1) +
      m3_test_realtime_dyad_on_error(test_sr, 40, 47, -3, 0.20, 1579) +
      m3_test_realtime_dyad_on_error(test_sr, 36, 40, 0, 0.08, 1207) +
      m3_test_realtime_dyad_on_error(test_sr, 32, 52, 0, 0.08, 1171) +
      m3_test_realtime_dyad_on_error(test_sr, 32, 56, 0, 0.08, 1183) +
      m3_test_realtime_eight_opens_error(test_sr) +
      m3_test_realtime_single_on_error(test_sr, 33, 0) +
      m3_test_realtime_single_on_error(test_sr, 37, 0) +
      m3_test_realtime_single_on_error(test_sr, 32, 1) +
      m3_test_realtime_single_on_error(test_sr, 48, 1) +
      m3_test_realtime_single_on_error(test_sr, 56, 1),
      0,
      0
    );
  );

  case_id == 4103 ? (
    best_note = m3_test_bank_tone(test_sr, 69, 35, 0.300, 0, 32, 72);
    gmem[13] = test_best_score;
    gmem[14] = M3_SALIENCE_BASE[69 - M3_RESONATOR_BASE[1]];
    gmem[31] = best_note;
    m3_test_near(4103, best_note, 69, 0);
  );

  case_id == 4104 ? (
    best_note = m3_test_bank_tone(test_sr, 40, 0, 0.300, 1, 32, 60);
    gmem[13] = test_best_score;
    gmem[14] = M3_SALIENCE_BASE[40 - M3_RESONATOR_BASE[1]];
    gmem[31] = best_note;
    m3_test_near(4104, best_note, 40, 0);
  );

  case_id == 4105 ? m3_test_bank_silence(test_sr);
  case_id == 4106 ? m3_test_bank_clipped_impulse(test_sr);
);

function m3_test_expected(index, note) (
  M3_UI_LOCAL_BASE[24 + index] = note;
);

function m3_test_selection_exact(id, selected_count, expected_count)
local(index, error, confidence, energy, onset) (
  error = abs(selected_count - expected_count);
  index = 0;
  loop(expected_count,
    error += abs(
      M3_SELECTION_BASE[index * 4] - M3_UI_LOCAL_BASE[24 + index]
    );
    confidence = M3_SELECTION_BASE[index * 4 + 1];
    energy = M3_SELECTION_BASE[index * 4 + 2];
    onset = M3_SELECTION_BASE[index * 4 + 3];
    error += (!m3_isfinite(confidence) || confidence <= 0) ? 1 : 0;
    error += (!m3_isfinite(energy) || energy <= 0) ? 1 : 0;
    error += abs(onset);
    index += 1;
  );
  m3_test_near(id, error, 0, 0);
);

function m3_test_selection_fixture_init(test_sr, test_min_note, test_max_note) (
  m3_bank_init(
    M3_RESONATOR_BASE,
    test_sr,
    test_min_note,
    test_max_note,
    440
  );
  m3_zero(M3_SALIENCE_BASE, M3_MAX_CANDIDATES);
  m3_zero(M3_UI_LOCAL_BASE, 32);
);

function m3_test_fixture_harmonic(note, harmonic, energy)
local(bank_candidate, cell) (
  bank_candidate = note - M3_RESONATOR_BASE[1];
  cell = m3_bank_cell(M3_RESONATOR_BASE, bank_candidate, harmonic);
  cell[4] = 0;
  cell[5] = 0;
  cell[6] = sqrt(max(0, energy) / 0.65);
  cell[7] = 0;
);

function m3_test_fixture_candidate(note, score, energy, independent)
local(bank_candidate, harmonic, fundamental_energy, other_energy) (
  bank_candidate = note - M3_RESONATOR_BASE[1];
  M3_SALIENCE_BASE[bank_candidate] = score;
  fundamental_energy = independent ? energy : 0.05 * energy;
  other_energy = independent ? 0.08 * energy : 0.80 * energy;
  m3_test_fixture_harmonic(note, 0, fundamental_energy);
  harmonic = 1;
  loop(M3_MAX_HARMONICS - 1,
    m3_test_fixture_harmonic(note, harmonic, other_energy);
    harmonic += 1;
  );
);

function m3_test_fixture_partial_candidate(note, score, fundamental, upper)
local(bank_candidate, harmonic) (
  bank_candidate = note - M3_RESONATOR_BASE[1];
  M3_SALIENCE_BASE[bank_candidate] = score;
  m3_test_fixture_harmonic(note, 0, fundamental);
  harmonic = 1;
  loop(M3_MAX_HARMONICS - 1,
    m3_test_fixture_harmonic(note, harmonic, upper);
    harmonic += 1;
  );
);

function m3_test_selection_fixture_run_mode(
  test_min_note, test_max_note, max_voices, allow_fundamental_dominance
)
local(requested_count, selected_count, local_energy_ratio) (
  requested_count = test_max_note - test_min_note + 1;
  allow_fundamental_dominance = allow_fundamental_dominance >= 0.5;
  local_energy_ratio = allow_fundamental_dominance
    ? M3_SELECTION_GENERAL_LOCAL_ENERGY_RATIO
    : M3_SELECTION_M3_LOCAL_ENERGY_RATIO;
  selected_count = m3_select_voices(
    M3_RESONATOR_BASE,
    M3_SALIENCE_BASE,
    test_min_note,
    requested_count,
    0.20,
    max_voices,
    440,
    local_energy_ratio,
    allow_fundamental_dominance,
    test_block_size,
    test_bank_rate,
    M3_SELECTION_BASE
  );
  selected_count;
);

function m3_test_selection_fixture_run(test_min_note, test_max_note, max_voices) (
  m3_test_selection_fixture_run_mode(
    test_min_note,
    test_max_note,
    max_voices,
    test_min_note >= 32
  );
);

function m3_test_selection_case(test_sr, case_id)
local(selected_count, bank_index, error) (
  case_id == 5101 ? (
    m3_test_selection_fixture_init(test_sr, 32, 64);

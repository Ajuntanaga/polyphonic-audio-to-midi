desc:ajuntanaga/M3 Polyphonic MIDI - Core Tests
tags:test MIDI analysis
options:gmem=m3_poly_midi_tests_v1
slider1:0<0,2,1{48 kHz,44.1 kHz,96 kHz}>Bounded resonator test rate
slider2:0<0,17,1{4101 G#1,4102 E2 Fast,4103 A4 +35c,4104 Missing Fundamental,4105 Silence,4106 Clipping,5101 E2 Ghosts,5102 E2+B2,5103 G#1+C2+E2,5104 Eight Opens,5105 Quiet True Note,5106 Three-Voice Cap,6101 Open Equivalence,6102 Selection Equivalence,6103 17 kHz Alias,6104 21 kHz Alias,6105 Work Bound,6106 Rate Guards}>Bounded detector test case
in_pin:none
out_pin:none

import ../m3_poly_midi/constants.jsfx-inc
import ../m3_poly_midi/pitch_math.jsfx-inc
import ../m3_poly_midi/conditioning.jsfx-inc
import ../m3_poly_midi/resonator_bank.jsfx-inc
import ../m3_poly_midi/salience_selector.jsfx-inc

@init
M3_TEST_MAGIC = 0x4D335431;
M3_TEST_REFERENCE_BANK_BASE = 50000;
M3_TEST_REFERENCE_SALIENCE_BASE = 56000;
M3_TEST_REFERENCE_SELECTION_BASE = 57000;
M3_TEST_RATE_NOTE_BASE = 58000;
M3_TEST_RATE_GAIN_BASE = 58008;
M3_TEST_RATE_PHASE_BASE = 58016;

function m3_test_near(id, actual, expected, tolerance) local(delta) (
  gmem[2] += 1;
  delta = abs(actual - expected);
  (!m3_isfinite(actual) || delta > tolerance) && gmem[3] == 0 ? (
    gmem[1] = -1;
    gmem[3] = id;
    gmem[4] = actual;
    gmem[5] = expected;
  );
);

function m3_test_lte(id, actual, maximum) (
  gmem[2] += 1;
  (!m3_isfinite(actual) || actual > maximum) && gmem[3] == 0 ? (
    gmem[1] = -1;
    gmem[3] = id;
    gmem[4] = actual;
    gmem[5] = maximum;
  );
);

function m3_test_gte(id, actual, minimum) (
  gmem[2] += 1;
  (!m3_isfinite(actual) || actual < minimum) && gmem[3] == 0 ? (
    gmem[1] = -1;
    gmem[3] = id;
    gmem[4] = actual;
    gmem[5] = minimum;
  );
);

function m3_test_condition_rate(test_sr)
local(base, count, y, phase, phase_step, x, input_energy, output_energy, gain_db) (
  base = M3_CONDITION_BASE;

  m3_condition_init(base, test_sr);
  count = floor(0.5 * test_sr);
  y = 0;
  loop(count,
    y = m3_condition_process(base, 1);
  );
  m3_test_lte(3101, abs(y), 0.001);

  m3_condition_init(base, test_sr);
  phase = 0;
  phase_step = 2 * $pi * 51.9131 / test_sr;
  count = floor(0.25 * test_sr);
  loop(count,
    x = sin(phase);
    m3_condition_process(base, x);
    phase += phase_step;
    phase >= 2 * $pi ? phase -= 2 * $pi;
  );
  input_energy = 0;
  output_energy = 0;
  count = floor(0.5 * test_sr);
  loop(count,
    x = sin(phase);
    y = m3_condition_process(base, x);
    input_energy += x * x;
    output_energy += y * y;
    phase += phase_step;
    phase >= 2 * $pi ? phase -= 2 * $pi;
  );
  gain_db = 10 * log10(
    max(output_energy, 0.000000000001) /
    max(input_energy, 0.000000000001)
  );
  m3_test_gte(3102, gain_db, -0.5);

  m3_condition_init(base, test_sr);
  y = m3_condition_process(base, 10 ^ 31);
  m3_test_near(3103, abs(y) + abs(base[15] - 1), 0, 0.000001);

  m3_condition_init(base, test_sr);
  m3_condition_process(base, 1);
  count = floor(0.25 * test_sr);
  loop(count,
    m3_condition_process(base, 0);
  );
  m3_test_gte(3104, base[14], 0.36);

  m3_condition_init(base, test_sr);
  count = floor(2 * test_sr);
  loop(count,
    m3_condition_process(base, 0);
  );
  m3_test_lte(3105, 10 * log10(max(base[12], 0.000000000001)), -100);
);

function m3_test_best_note(bank_base, salience_base)
local(min_note, candidate_count, candidate, last_candidate, best_note,
      best_score, score) (
  min_note = bank_base[1];
  candidate_count = bank_base[4];
  candidate = max(0, bank_base[10]);
  last_candidate = min(candidate_count - 1, bank_base[11]);
  best_note = min_note + candidate;
  best_score = -1;
  loop(max(0, last_candidate - candidate + 1),
    score = salience_base[candidate];
    score > best_score ? (
      best_score = score;
      best_note = min_note + candidate;
    );
    candidate += 1;
  );
  test_best_score = best_score;
  best_note;
);

function m3_test_bank_tone(test_sr, note, cents, duration, missing_fundamental,
                           test_min_note, test_max_note)
local(frequency, phase, phase_step, sample_index, sample_count, attack_samples,
      attack, sample, best_note) (
  m3_bank_init(
    M3_RESONATOR_BASE,
    test_sr,
    test_min_note,
    test_max_note,
    440
  );
  frequency = m3_midi_to_hz(note, 440) * 2 ^ (cents / 1200);
  phase = 0;
  phase_step = 2 * $pi * frequency / test_sr;
  sample_index = 0;
  sample_count = floor(duration * test_sr);
  attack_samples = max(1, floor(0.005 * test_sr));
  loop(sample_count,
    attack = sample_index < attack_samples
           ? 0.5 - 0.5 * cos($pi * sample_index / attack_samples)
           : 1;
    missing_fundamental
      ? sample = attack * 0.18 * (
          sin(2 * phase) + sin(3 * phase) + sin(4 * phase) +
          sin(5 * phase) + sin(6 * phase)
        )
      : sample = attack * 0.8 * sin(phase);
    m3_bank_process(M3_RESONATOR_BASE, sample);
    phase += phase_step;
    phase >= 2 * $pi ? phase -= 2 * $pi;
    sample_index += 1;
  );
  M3_SALIENCE_BASE[128] = 0.20;
  M3_SALIENCE_BASE[129] = 0;
  m3_salience_update(M3_RESONATOR_BASE, M3_SALIENCE_BASE, 0.000000000001);
  best_note = m3_test_best_note(M3_RESONATOR_BASE, M3_SALIENCE_BASE);
  best_note;
);

function m3_test_bank_silence(test_sr)
local(sample_count, best_note) (
  m3_bank_init(M3_RESONATOR_BASE, test_sr, 32, 32, 440);
  sample_count = floor(0.300 * test_sr);
  loop(sample_count,
    m3_bank_process(M3_RESONATOR_BASE, 0);
  );
  M3_SALIENCE_BASE[128] = 0.20;
  M3_SALIENCE_BASE[129] = 0;
  m3_salience_update(M3_RESONATOR_BASE, M3_SALIENCE_BASE, 0.000000000001);
  best_note = m3_test_best_note(M3_RESONATOR_BASE, M3_SALIENCE_BASE);
  m3_test_lte(4105, test_best_score, M3_SALIENCE_BASE[130]);
);

function m3_test_bank_clipped_impulse(test_sr)
local(sample_count, best_note, threshold_error, excess_score) (
  m3_bank_init(M3_RESONATOR_BASE, test_sr, 32, 32, 440);
  m3_bank_process(M3_RESONATOR_BASE, 1);
  sample_count = floor(0.300 * test_sr) - 1;
  loop(sample_count,
    m3_bank_process(M3_RESONATOR_BASE, 0);
  );
  M3_SALIENCE_BASE[128] = 0.20;
  M3_SALIENCE_BASE[129] = 1;
  m3_salience_update(M3_RESONATOR_BASE, M3_SALIENCE_BASE, 0.000000000001);
  best_note = m3_test_best_note(M3_RESONATOR_BASE, M3_SALIENCE_BASE);
  threshold_error = abs(M3_SALIENCE_BASE[130] - 0.28);
  excess_score = max(0, test_best_score - M3_SALIENCE_BASE[130]);
  m3_test_near(4106, threshold_error + excess_score, 0, 0.000001);
);

function m3_test_bank_case(test_sr, case_id) local(best_note) (
  case_id == 4101 ? (
    best_note = m3_test_bank_tone(test_sr, 32, 0, 0.300, 0, 32, 60);
    m3_test_near(
      4107,
      abs(M3_RESONATOR_BASE[1] - 31) +
      abs(M3_RESONATOR_BASE[2] - 61) +
      abs(M3_RESONATOR_BASE[8] - 32) +
      abs(M3_RESONATOR_BASE[9] - 60),
      0,
      0
    );
    m3_test_near(4101, best_note, 32, 0);
  );

  case_id == 4102 ? (
    best_note = m3_test_bank_tone(test_sr, 40, 0, 0.045, 0, 32, 52);
    m3_test_near(4102, best_note, 40, 0);
  );

  case_id == 4103 ? (
    best_note = m3_test_bank_tone(test_sr, 69, 35, 0.300, 0, 32, 72);
    m3_test_near(4103, best_note, 69, 0);
  );

  case_id == 4104 ? (
    best_note = m3_test_bank_tone(test_sr, 40, 0, 0.300, 1, 32, 60);
    m3_test_near(4104, best_note, 40, 0);
  );

  case_id == 4105 ? m3_test_bank_silence(test_sr);
  case_id == 4106 ? m3_test_bank_clipped_impulse(test_sr);
);

function m3_test_expected(index, note) (
  M3_UI_LOCAL_BASE[24 + index] = note;
);

function m3_test_selection_exact(id, selected_count, expected_count)
local(index, error, confidence, energy, onset) (
  error = abs(selected_count - expected_count);
  index = 0;
  loop(expected_count,
    error += abs(
      M3_SELECTION_BASE[index * 4] - M3_UI_LOCAL_BASE[24 + index]
    );
    confidence = M3_SELECTION_BASE[index * 4 + 1];
    energy = M3_SELECTION_BASE[index * 4 + 2];
    onset = M3_SELECTION_BASE[index * 4 + 3];
    error += (!m3_isfinite(confidence) || confidence <= 0) ? 1 : 0;
    error += (!m3_isfinite(energy) || energy <= 0) ? 1 : 0;
    error += abs(onset);
    index += 1;
  );
  m3_test_near(id, error, 0, 0);
);

function m3_test_selection_fixture_init(test_sr, test_min_note, test_max_note) (
  m3_bank_init(
    M3_RESONATOR_BASE,
    test_sr,
    test_min_note,
    test_max_note,
    440
  );
  m3_zero(M3_SALIENCE_BASE, M3_MAX_CANDIDATES);
  m3_zero(M3_UI_LOCAL_BASE, 32);
);

function m3_test_fixture_harmonic(note, harmonic, energy)
local(bank_candidate, cell) (
  bank_candidate = note - M3_RESONATOR_BASE[1];
  cell = m3_bank_cell(M3_RESONATOR_BASE, bank_candidate, harmonic);
  cell[4] = 0;
  cell[5] = 0;
  cell[6] = sqrt(max(0, energy) / 0.65);
  cell[7] = 0;
);

function m3_test_fixture_candidate(note, score, energy, independent)
local(bank_candidate, harmonic, fundamental_energy, other_energy) (
  bank_candidate = note - M3_RESONATOR_BASE[1];
  M3_SALIENCE_BASE[bank_candidate] = score;
  fundamental_energy = independent ? energy : 0.05 * energy;
  other_energy = independent ? 0.08 * energy : 0.80 * energy;
  m3_test_fixture_harmonic(note, 0, fundamental_energy);
  harmonic = 1;
  loop(M3_MAX_HARMONICS - 1,
    m3_test_fixture_harmonic(note, harmonic, other_energy);
    harmonic += 1;
  );
);

function m3_test_selection_fixture_run(test_min_note, test_max_note, max_voices)
local(requested_count, selected_count) (
  requested_count = test_max_note - test_min_note + 1;
  selected_count = m3_select_voices(
    M3_RESONATOR_BASE,
    M3_SALIENCE_BASE,
    test_min_note,
    requested_count,
    0.20,
    max_voices,
    440,
    M3_SELECTION_BASE
  );
  selected_count;
);

function m3_test_selection_case(test_sr, case_id)
local(selected_count, bank_index, error) (
  case_id == 5101 ? (
    m3_test_selection_fixture_init(test_sr, 32, 64);
    m3_test_fixture_candidate(40, 0.95, 1.00, 1);
    m3_test_fixture_candidate(52, 0.80, 0.50, 0);
    m3_test_fixture_candidate(59, 0.75, 0.40, 0);
    m3_test_expected(0, 40);
    selected_count = m3_test_selection_fixture_run(32, 64, 8);
    m3_test_selection_exact(5101, selected_count, 1);
  );

  case_id == 5102 ? (
    m3_test_selection_fixture_init(test_sr, 32, 64);
    m3_test_fixture_candidate(40, 0.85, 1.00, 1);
    m3_test_fixture_candidate(47, 0.95, 0.50, 1);
    m3_test_fixture_candidate(52, 0.80, 0.50, 0);
    m3_test_fixture_candidate(59, 0.75, 0.40, 0);
    m3_test_expected(0, 40);
    m3_test_expected(1, 47);
    selected_count = m3_test_selection_fixture_run(32, 64, 8);
    m3_test_selection_exact(5102, selected_count, 2);
  );

  case_id == 5103 ? (
    m3_test_selection_fixture_init(test_sr, 32, 64);
    m3_test_fixture_candidate(32, 0.95, 1.00, 1);
    m3_test_fixture_candidate(36, 0.90, 0.80, 1);
    m3_test_fixture_candidate(40, 0.85, 0.60, 1);
    m3_test_fixture_candidate(44, 0.82, 0.50, 0);
    m3_test_fixture_candidate(48, 0.78, 0.45, 0);
    m3_test_fixture_candidate(51, 0.72, 0.40, 0);
    m3_test_fixture_candidate(52, 0.74, 0.42, 0);
    m3_test_fixture_candidate(55, 0.68, 0.35, 0);
    m3_test_fixture_candidate(59, 0.64, 0.30, 0);
    m3_test_expected(0, 32);
    m3_test_expected(1, 36);
    m3_test_expected(2, 40);
    selected_count = m3_test_selection_fixture_run(32, 64, 8);
    m3_test_selection_exact(5103, selected_count, 3);
  );

  case_id == 5104 ? (
    m3_test_selection_fixture_init(test_sr, 32, 72);
    m3_test_fixture_candidate(32, 0.95, 1.00, 1);
    m3_test_fixture_candidate(36, 0.91, 0.90, 1);
    m3_test_fixture_candidate(40, 0.87, 0.80, 1);
    m3_test_fixture_candidate(44, 0.83, 0.70, 1);
    m3_test_fixture_candidate(48, 0.79, 0.60, 1);
    m3_test_fixture_candidate(52, 0.75, 0.50, 1);
    m3_test_fixture_candidate(56, 0.71, 0.40, 1);
    m3_test_fixture_candidate(60, 0.67, 0.30, 1);
    m3_test_fixture_candidate(63, 0.66, 0.30, 0);
    m3_test_fixture_candidate(67, 0.62, 0.25, 0);
    m3_test_fixture_candidate(71, 0.58, 0.20, 0);
    m3_test_expected(0, 32);
    m3_test_expected(1, 36);
    m3_test_expected(2, 40);
    m3_test_expected(3, 44);
    m3_test_expected(4, 48);
    m3_test_expected(5, 52);
    m3_test_expected(6, 56);
    m3_test_expected(7, 60);
    selected_count = m3_test_selection_fixture_run(32, 72, 8);
    m3_test_selection_exact(5104, selected_count, 8);
  );

  case_id == 5105 ? (
    m3_test_selection_fixture_init(test_sr, 32, 64);
    m3_test_fixture_candidate(40, 0.95, 1.00, 1);
    m3_test_fixture_candidate(47, 0.82, 0.25, 1);
    m3_test_fixture_candidate(52, 0.60, 10 ^ (-24 / 10), 1);
    m3_test_fixture_candidate(57, 0.55, 0.063, 1);
    m3_test_fixture_candidate(59, 0.80, 0.50, 0);
    m3_test_fixture_candidate(64, 0.75, 0.40, 0);
    m3_test_expected(0, 40);
    m3_test_expected(1, 47);
    m3_test_expected(2, 52);
    m3_test_expected(3, 57);
    selected_count = m3_test_selection_fixture_run(32, 64, 8);
    m3_test_selection_exact(5105, selected_count, 4);
  );

  case_id == 5106 ? (
    m3_bank_init(M3_RESONATOR_BASE, test_sr, 32, 60, 440);
    m3_zero(M3_SALIENCE_BASE, M3_MAX_CANDIDATES);
    bank_index = 32 - M3_RESONATOR_BASE[1];
    M3_SALIENCE_BASE[bank_index] = 0.90;
    M3_SALIENCE_BASE[36 - M3_RESONATOR_BASE[1]] = 0.80;
    M3_SALIENCE_BASE[40 - M3_RESONATOR_BASE[1]] = 0.70;
    M3_SALIENCE_BASE[43 - M3_RESONATOR_BASE[1]] = 0.60;
    M3_SELECTION_BASE[-1] = 1234567;
    M3_M3_SCRATCH_BASE[0] = 7654321;
    selected_count = m3_select_voices(
      M3_RESONATOR_BASE,
      M3_SALIENCE_BASE,
      32,
      29,
      0.20,
      3,
      440,
      M3_SELECTION_BASE
    );
    error = abs(selected_count - 3) +
            abs(M3_SELECTION_BASE[0] - 32) +
            abs(M3_SELECTION_BASE[4] - 36) +
            abs(M3_SELECTION_BASE[8] - 40) +
            abs(M3_SELECTION_BASE[-1] - 1234567) +
            abs(M3_M3_SCRATCH_BASE[0] - 7654321);
    m3_test_near(5106, error, 0, 0);
  );
);

function m3_test_rate_voice(index, note, gain) (
  M3_TEST_RATE_NOTE_BASE[index] = note;
  M3_TEST_RATE_GAIN_BASE[index] = gain;
);

function m3_test_rate_case_setup(case_index) (
  m3_zero(M3_TEST_RATE_NOTE_BASE, 8);
  m3_zero(M3_TEST_RATE_GAIN_BASE, 8);
  test_rate_max_voices = 8;
  test_rate_voice_count = 0;

  case_index == 0 ? (
    m3_test_rate_voice(0, 40, 1);
    test_rate_voice_count = 1;
  );
  case_index == 1 ? (
    m3_test_rate_voice(0, 40, 1);
    m3_test_rate_voice(1, 47, 0.71);
    test_rate_voice_count = 2;
  );
  case_index == 2 ? (
    m3_test_rate_voice(0, 32, 1);
    m3_test_rate_voice(1, 36, 0.79);
    m3_test_rate_voice(2, 40, 0.63);
    test_rate_voice_count = 3;
  );
  case_index == 3 || case_index == 5 ? (
    m3_test_rate_voice(0, 32, 1);
    m3_test_rate_voice(1, 36, 1);
    m3_test_rate_voice(2, 40, 1);
    m3_test_rate_voice(3, 44, 1);
    m3_test_rate_voice(4, 48, 1);
    m3_test_rate_voice(5, 52, 1);
    m3_test_rate_voice(6, 56, 1);
    m3_test_rate_voice(7, 60, 1);
    test_rate_voice_count = 8;
    case_index == 5 ? test_rate_max_voices = 3;
  );
  case_index == 4 ? (
    m3_test_rate_voice(0, 40, 1);
    m3_test_rate_voice(1, 47, 0.50);
    m3_test_rate_voice(2, 52, 10 ^ (-24 / 20));
    m3_test_rate_voice(3, 57, 0.25);
    test_rate_voice_count = 4;
  );
  test_rate_voice_count;
);

function m3_test_rate_process_pair(test_sr, voice_count, duration,
                                   test_min_note, test_max_note)
local(sample_index, sample_count, attack_samples, attack, voice, phase,
      phase_step, sample) (
  m3_bank_init(
    M3_RESONATOR_BASE,
    test_sr,
    test_min_note,
    test_max_note,
    440
  );
  m3_bank_init_reference(
    M3_TEST_REFERENCE_BANK_BASE,
    test_sr,
    test_min_note,
    test_max_note,
    440
  );
  m3_zero(M3_TEST_RATE_PHASE_BASE, 8);
  sample_index = 0;
  sample_count = floor(duration * test_sr);
  attack_samples = max(1, floor(0.005 * test_sr));
  loop(sample_count,
    attack = sample_index < attack_samples
           ? 0.5 - 0.5 * cos($pi * sample_index / attack_samples)
           : 1;
    sample = 0;
    voice = 0;
    loop(voice_count,
      phase = M3_TEST_RATE_PHASE_BASE[voice];
      sample += M3_TEST_RATE_GAIN_BASE[voice] * (
        sin(phase) +
        0.50 * sin(2 * phase) +
        0.32 * sin(3 * phase) +
        0.22 * sin(4 * phase)
      );
      phase_step = 2 * $pi * m3_midi_to_hz(
        M3_TEST_RATE_NOTE_BASE[voice],
        440
      ) / test_sr;
      phase += phase_step;
      phase >= 2 * $pi ? phase -= 2 * $pi;
      M3_TEST_RATE_PHASE_BASE[voice] = phase;
      voice += 1;
    );
    sample *= attack * 0.29 / max(1, voice_count);
    m3_bank_process(M3_RESONATOR_BASE, sample);
    m3_bank_process_reference(M3_TEST_REFERENCE_BANK_BASE, sample);
    sample_index += 1;
  );
  m3_salience_update(
    M3_RESONATOR_BASE,
    M3_SALIENCE_BASE,
    0.00001
  );
  m3_salience_update(
    M3_TEST_REFERENCE_BANK_BASE,
    M3_TEST_REFERENCE_SALIENCE_BASE,
    0.00001
  );
);

function m3_test_rate_selection_error(test_min_note, test_max_note, max_voices)
local(candidate_count, production_count, reference_count, index, error) (
  candidate_count = test_max_note - test_min_note + 1;
  production_count = m3_select_voices(
    M3_RESONATOR_BASE,
    M3_SALIENCE_BASE,
    test_min_note,
    candidate_count,
    0.20,
    max_voices,
    440,
    M3_SELECTION_BASE
  );
  reference_count = m3_select_voices(
    M3_TEST_REFERENCE_BANK_BASE,
    M3_TEST_REFERENCE_SALIENCE_BASE,
    test_min_note,
    candidate_count,
    0.20,
    max_voices,
    440,
    M3_TEST_REFERENCE_SELECTION_BASE
  );
  test_rate_last_production_count = production_count;
  test_rate_last_reference_count = reference_count;
  test_rate_last_production_note = M3_SELECTION_BASE[0];
  test_rate_last_reference_note = M3_TEST_REFERENCE_SELECTION_BASE[0];
  error = abs(production_count - reference_count);
  index = 0;
  loop(M3_MAX_VOICES,
    error += abs(
      M3_SELECTION_BASE[index * M3_SELECTION_CELL_SIZE] -
      M3_TEST_REFERENCE_SELECTION_BASE[index * M3_SELECTION_CELL_SIZE]
    );
    index += 1;
  );
  error;
);

function m3_test_rate_alias_score(test_sr, frequency)
local(sample_index, sample_count, attack_samples, attack, phase, phase_step,
      candidate, last_candidate, score) (
  m3_bank_init(M3_RESONATOR_BASE, test_sr, 24, 60, 440);
  sample_index = 0;
  sample_count = floor(0.300 * test_sr);
  attack_samples = max(1, floor(0.005 * test_sr));
  phase = 0;
  phase_step = 2 * $pi * frequency / test_sr;
  loop(sample_count,
    attack = sample_index < attack_samples
           ? 0.5 - 0.5 * cos($pi * sample_index / attack_samples)
           : 1;
    m3_bank_process(M3_RESONATOR_BASE, attack * 0.80 * sin(phase));
    phase += phase_step;
    phase >= 2 * $pi ? phase -= 2 * $pi;
    sample_index += 1;
  );
  m3_salience_update(
    M3_RESONATOR_BASE,
    M3_SALIENCE_BASE,
    0.00001
  );
  candidate = M3_RESONATOR_BASE[10];
  last_candidate = M3_RESONATOR_BASE[11];
  score = 0;
  loop(last_candidate - candidate + 1,
    score = max(score, M3_SALIENCE_BASE[candidate]);
    candidate += 1;
  );
  score;
);

function m3_test_rate_enabled_cells(bank_base)
local(candidate, harmonic, enabled) (
  candidate = 0;
  enabled = 0;
  loop(bank_base[4],
    harmonic = 0;
    loop(M3_MAX_HARMONICS,
      m3_bank_enabled(bank_base, candidate, harmonic) ? enabled += 1;
      harmonic += 1;
    );
    candidate += 1;
  );
  enabled;
);

function m3_test_multi_rate_case(test_sr, case_id)
local(index, note, production_index, reference_index, delta, max_delta,
      variant, voice_count, selection_error, alias_score, sample_count,
      average_updates, enabled_cells, guard_error) (
  case_id == 6101 ? (
    voice_count = m3_test_rate_case_setup(3);
    m3_test_rate_process_pair(test_sr, voice_count, 0.300, 32, 60);
    index = 0;
    max_delta = 0;
    loop(8,
      note = M3_TEST_RATE_NOTE_BASE[index];
      production_index = note - M3_RESONATOR_BASE[1];
      reference_index = note - M3_TEST_REFERENCE_BANK_BASE[1];
      delta = abs(
        M3_SALIENCE_BASE[production_index] -
        M3_TEST_REFERENCE_SALIENCE_BASE[reference_index]
      );
      delta > max_delta ? (
        max_delta = delta;
        gmem[10] = note;
        gmem[11] = M3_SALIENCE_BASE[production_index];
        gmem[12] = M3_TEST_REFERENCE_SALIENCE_BASE[reference_index];
      );
      gmem[16 + index] = M3_SALIENCE_BASE[production_index];
      gmem[24 + index] = M3_TEST_REFERENCE_SALIENCE_BASE[reference_index];
      index += 1;
    );
    gmem[7] = max_delta;
    m3_test_lte(6101, max_delta, 0.03);
  );

  case_id == 6102 ? (
    variant = 0;
    selection_error = 0;
    loop(6,
      voice_count = m3_test_rate_case_setup(variant);
      m3_test_rate_process_pair(test_sr, voice_count, 0.150, 32, 72);
      delta = m3_test_rate_selection_error(
        32,
        72,
        min(test_rate_max_voices, voice_count)
      );
      selection_error += delta;
      delta > 0 ? (
        gmem[10] = variant;
        gmem[11] = test_rate_last_production_count;
        gmem[12] = test_rate_last_reference_count;
        gmem[13] = test_rate_last_production_note;
        gmem[14] = test_rate_last_reference_note;
        index = 0;
        loop(M3_MAX_VOICES,
          gmem[16 + index] =
            M3_SELECTION_BASE[index * M3_SELECTION_CELL_SIZE];
          gmem[24 + index] =
            M3_TEST_REFERENCE_SELECTION_BASE[index * M3_SELECTION_CELL_SIZE];
          index += 1;
        );
      );
      variant += 1;
    );
    m3_test_near(6102, selection_error, 0, 0);
  );

  case_id == 6103 ? (
    alias_score = m3_test_rate_alias_score(
      test_sr,
      17000 * test_sr / 48000
    );
    m3_test_lte(6103, alias_score, 0.20);
  );

  case_id == 6104 ? (
    alias_score = m3_test_rate_alias_score(
      test_sr,
      21000 * test_sr / 96000
    );
    m3_test_lte(6104, alias_score, 0.20);
  );

  case_id == 6105 ? (
    m3_bank_init(M3_RESONATOR_BASE, 48000, 32, 84, 440);
    enabled_cells = m3_test_rate_enabled_cells(M3_RESONATOR_BASE);
    sample_count = 64;
    loop(sample_count,
      m3_bank_process(M3_RESONATOR_BASE, 0);
    );
    average_updates = M3_RATE_BASE[M3_RATE_CELL_UPDATES_OFFSET] /
                      max(1, M3_RATE_BASE[M3_RATE_INPUT_SAMPLES_OFFSET]);
    gmem[8] = average_updates;
    gmem[9] = enabled_cells;
    m3_test_lte(6105, average_updates, 45);
  );

  case_id == 6106 ? (
    m3_bank_init(M3_RESONATOR_BASE, test_sr, 32, 84, 440);
    M3_RATE_BASE[M3_RATE_GUARD_LOW_OFFSET] = 1234567;
    M3_RATE_BASE[M3_RATE_GUARD_HIGH_OFFSET] = 7654321;
    sample_count = 64;
    loop(sample_count,
      m3_bank_process(M3_RESONATOR_BASE, 0.125);
    );
    guard_error = abs(
      M3_RATE_BASE[M3_RATE_GUARD_LOW_OFFSET] - 1234567
    ) + abs(
      M3_RATE_BASE[M3_RATE_GUARD_HIGH_OFFSET] - 7654321
    );
    m3_test_near(6106, guard_error, 0, 0);
  );
);

gmem[0] = M3_TEST_MAGIC;
gmem[1] = 1;
gmem[2] = 0;
gmem[3] = 0;
gmem[4] = 0;
gmem[5] = 0;
gmem[7] = 0;
gmem[8] = 0;
gmem[9] = 0;
gmem[10] = 0;
gmem[11] = 0;
gmem[12] = 0;
gmem[13] = 0;
gmem[14] = 0;
test_diagnostic_index = 16;
loop(16,
  gmem[test_diagnostic_index] = 0;
  test_diagnostic_index += 1;
);
test_bank_rate = slider1 == 1 ? 44100 : slider1 == 2 ? 96000 : 48000;
test_case_index = min(17, max(0, slider2|0));
test_bank_case_id = test_case_index < 6
  ? 4101 + test_case_index
  : test_case_index < 12
    ? 5101 + test_case_index - 6
    : 6101 + test_case_index - 12;
gmem[6] = test_bank_rate;
gmem[15] = test_bank_case_id;

m3_test_near(2101, m3_midi_to_hz(69, 440), 440, 0.000001);
m3_test_near(2102, m3_midi_to_hz(32, 440), 51.9131, 0.01);
test_bank_case_id == 4101 ? (
  m3_test_condition_rate(48000);
  m3_test_condition_rate(44100);
  m3_test_condition_rate(96000);
);
test_bank_case_id < 5000 ? (
  m3_test_bank_case(test_bank_rate, test_bank_case_id);
) : test_bank_case_id < 6000 ? (
  m3_test_selection_case(test_bank_rate, test_bank_case_id);
) : (
  m3_test_multi_rate_case(test_bank_rate, test_bank_case_id);
);
gmem[1] == 1 ? gmem[1] = 2;

@gfx 440 220
gfx_set(0.80, 0.84, 0.90, 1);
gfx_x = 16;
gfx_y = 16;
gmem[1] == 2 ? gfx_drawstr("PASS") :
gmem[1] == -1 ? gfx_drawstr("FAIL") : gfx_drawstr("RUNNING");
gfx_x = 16;
gfx_y = 44;
gfx_printf("Assertions: %d", gmem[2]);
gfx_x = 16;
gfx_y = 68;
gfx_printf("Failed assertion ID: %d", gmem[3]);
gfx_x = 16;
gfx_y = 92;
gfx_printf("Observed: %.6f", gmem[4]);
gfx_x = 16;
gfx_y = 116;
gfx_printf("Expected: %.6f", gmem[5]);
gfx_x = 16;
gfx_y = 140;
gfx_printf("Resonator rate: %d Hz", gmem[6]);
gfx_x = 16;
gfx_y = 164;
gfx_printf("Resonator case: %d", gmem[15]);

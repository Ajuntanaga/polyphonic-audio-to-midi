    );
    error += abs(cleanup_count - 3) + m3_test_lifecycle_active_count();
    m3_test_near(12114, error, 0, 0);

    m3_test_lifecycle_reset();
    m3_lifecycle_max_active_voices = 3;
    m3_lifecycle_reserve_lower_attacks = 1;
    m3_lifecycle_attack_hysteresis = 1;
    m3_lifecycle_attack_bridge_samples = 2 * test_block_size;
    m3_lifecycle_attack_evidence_step_samples = test_block_size;
    cell = M3_VOICE_BASE + 43 * M3_VOICE_CELL_SIZE;
    cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ON;
    cell[M3_VOICE_CONFIDENCE_OFFSET] = 0.80;
    cell[M3_VOICE_ENERGY_OFFSET] = 0.25;
    cell[M3_VOICE_FIRST_EVIDENCE_OFFSET] = 0;
    cell[M3_VOICE_LAST_EVIDENCE_OFFSET] = 0;
    cell[M3_VOICE_STATE_ENTER_OFFSET] = 0;
    cell[M3_VOICE_VELOCITY_OFFSET] = 64;
    cell[M3_VOICE_ACTIVE_OFFSET] = 1;
    checkpoint_time = max(attack_samples, dropout_samples);
    cell = M3_VOICE_BASE + 32 * M3_VOICE_CELL_SIZE;
    cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ATTACK;
    cell[M3_VOICE_CONFIDENCE_OFFSET] = 0.80;
    cell[M3_VOICE_ENERGY_OFFSET] = 0.25;
    cell[M3_VOICE_FIRST_EVIDENCE_OFFSET] = 0;
    cell[M3_VOICE_LAST_EVIDENCE_OFFSET] = checkpoint_time;
    cell[M3_VOICE_STATE_ENTER_OFFSET] = checkpoint_time;
    m3_test_lifecycle_select(0, 32, 0.80, 0.25);
    event_count = m3_test_lifecycle_update_default(
      1, checkpoint_time, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error = abs(event_count - 1) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 32) +
            abs(m3_test_lifecycle_active_count() - 2);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 2) + m3_test_lifecycle_active_count();
    m3_test_near(12114, error, 0, 0);

  );

  case_id == 12117 ? (
    m3_lifecycle_response_for_profile(
      M3_PROFILE_MODE_M3,
      0,
      test_sr,
      0.08,
      M3_TEST_LIFECYCLE_RESPONSE_BASE
    );
    attack_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
      M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET
    ];
    release_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
      M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET
    ];
    dropout_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
      M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET
    ];
    m3_test_lifecycle_reset();
    m3_lifecycle_m3_low_string_guard = 1;
    cell = M3_VOICE_BASE + 32 * M3_VOICE_CELL_SIZE;
    cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ON;
    cell[M3_VOICE_CONFIDENCE_OFFSET] = 0.80;
    cell[M3_VOICE_ENERGY_OFFSET] = 1.00;
    cell[M3_VOICE_FIRST_EVIDENCE_OFFSET] = 0;
    cell[M3_VOICE_LAST_EVIDENCE_OFFSET] = 0;
    cell[M3_VOICE_STATE_ENTER_OFFSET] = 0;
    cell[M3_VOICE_VELOCITY_OFFSET] = 64;
    cell[M3_VOICE_ACTIVE_OFFSET] = 1;
    m3_test_lifecycle_select(0, 33, 0.80, 0.80);
    first_count = m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    second_count = m3_test_lifecycle_update_default(
      1, dropout_samples + 1, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    third_count = m3_test_lifecycle_update_default(
      1, dropout_samples + 1 + attack_samples, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error = first_count + second_count + abs(third_count - 1) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 33) +
            abs(m3_test_lifecycle_active_count() - 2);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 2) + m3_test_lifecycle_active_count();
    m3_test_near(12117, error, 0, 0);

    m3_test_lifecycle_reset();
    m3_lifecycle_m3_low_open_fast_attack = 1;
    m3_test_lifecycle_select(0, 32, 0.80, 1.00);
    first_count = m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    second_count = m3_test_lifecycle_update_default(
      1, m3_lifecycle_m3_guarded_open_attack_samples, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error = first_count + abs(second_count - 1) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 32) +
            abs(m3_test_lifecycle_active_count() - 1);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    m3_test_near(12117, error, 0, 0);

    m3_test_lifecycle_reset();
    m3_lifecycle_attack_hysteresis = 1;
    m3_test_lifecycle_select(0, 40, 0.80, 1.00);
    first_count = m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_lifecycle_attack_bridge_samples = test_block_size;
    gap_time = max(
      1,
      attack_samples - min(test_block_size, dropout_samples)
    );
    m3_test_lifecycle_select(0, 40, 0.80, 1.00);
    second_count = m3_test_lifecycle_update_default(
      1, gap_time, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_zero(M3_SELECTION_BASE, M3_SELECTION_RESULT_WORDS);
    third_count = m3_test_lifecycle_update_default(
      0, attack_samples, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    cell = M3_VOICE_BASE + 40 * M3_VOICE_CELL_SIZE;
    error = first_count + second_count + third_count +
            abs(cell[M3_VOICE_STATE_OFFSET] - M3_LIFECYCLE_STATE_ATTACK) +
            m3_test_lifecycle_active_count();
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += cleanup_count +
             abs(cell[M3_VOICE_STATE_OFFSET]) +
             m3_test_lifecycle_active_count();
    m3_test_near(12117, error, 0, 0);

    m3_test_lifecycle_reset();
    m3_lifecycle_m3_octave_confirmation = 1;
    cell = M3_VOICE_BASE + 32 * M3_VOICE_CELL_SIZE;
    cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ON;
    cell[M3_VOICE_CONFIDENCE_OFFSET] = 0.80;
    cell[M3_VOICE_ENERGY_OFFSET] = 1.00;
    cell[M3_VOICE_FIRST_EVIDENCE_OFFSET] = 0;
    cell[M3_VOICE_LAST_EVIDENCE_OFFSET] = 0;
    cell[M3_VOICE_STATE_ENTER_OFFSET] = 0;
    cell[M3_VOICE_VELOCITY_OFFSET] = 64;
    cell[M3_VOICE_ACTIVE_OFFSET] = 1;
    m3_test_lifecycle_select(0, 44, 0.40, 0.80);
    first_count = m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    second_count = m3_test_lifecycle_update_default(
      1, attack_samples, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    third_count = m3_test_lifecycle_update_default(
      1, attack_samples + test_block_size, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error = first_count + second_count + abs(third_count - 1) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 44) +
            abs(m3_test_lifecycle_active_count() - 2);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 2) + m3_test_lifecycle_active_count();

    m3_test_lifecycle_reset();
    m3_lifecycle_m3_octave_confirmation = 1;
    cell = M3_VOICE_BASE + 32 * M3_VOICE_CELL_SIZE;
    cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ATTACK;
    cell[M3_VOICE_CONFIDENCE_OFFSET] = 0.40;
    cell = M3_VOICE_BASE + 33 * M3_VOICE_CELL_SIZE;
    cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ATTACK;
    cell[M3_VOICE_CONFIDENCE_OFFSET] = 0.80;
    error += abs(
      m3_lifecycle_m3_adjacent_shadow_blocked(M3_VOICE_BASE, 33, 0) - 1
    );
    m3_lifecycle_clear_voice(
      M3_VOICE_BASE + 32 * M3_VOICE_CELL_SIZE
    );
    error += m3_lifecycle_m3_adjacent_shadow_blocked(
      M3_VOICE_BASE,
      33,
      0
    );

    m3_test_lifecycle_reset();
    m3_lifecycle_m3_octave_confirmation = 1;
    m3_lifecycle_attack_hysteresis = 1;
    m3_lifecycle_attack_bridge_samples = 2 * test_block_size;
    m3_lifecycle_attack_evidence_step_samples = test_block_size;
    cell = M3_VOICE_BASE + 44 * M3_VOICE_CELL_SIZE;
    cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ON;
    cell[M3_VOICE_CONFIDENCE_OFFSET] = 0.80;
    cell[M3_VOICE_ENERGY_OFFSET] = 1.00;
    cell[M3_VOICE_FIRST_EVIDENCE_OFFSET] = 0;
    cell[M3_VOICE_LAST_EVIDENCE_OFFSET] = 0;
    cell[M3_VOICE_STATE_ENTER_OFFSET] = 0;
    cell[M3_VOICE_VELOCITY_OFFSET] = 64;
    cell[M3_VOICE_ACTIVE_OFFSET] = 1;
    checkpoint_time = max(
      1,
      ceil(0.040 * test_sr / test_block_size)
    );
    event_count = 0;
    index = 0;
    loop(max(0, checkpoint_time - 1),
      m3_test_lifecycle_select(0, 33, 0.80, 0.80);
      m3_test_lifecycle_select(1, 44, 0.80, 1.00);
      event_count += m3_test_lifecycle_update_default(
        2, index * test_block_size, 0,
        attack_samples, release_samples, dropout_samples,
        M3_VELOCITY_MODE_FIXED, 64
      );
      index += 1;
    );
    cell = M3_VOICE_BASE + 33 * M3_VOICE_CELL_SIZE;
    error += event_count +
             abs(cell[M3_VOICE_STATE_OFFSET] - M3_LIFECYCLE_STATE_ATTACK) +
             abs(m3_test_lifecycle_active_count() - 1);
    m3_test_lifecycle_select(0, 33, 0.80, 0.80);
    m3_test_lifecycle_select(1, 44, 0.80, 1.00);
    first_count = m3_test_lifecycle_update_default(
      2, index * test_block_size, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error += abs(first_count - 1) +
             abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
             abs(event[M3_EVENT_NOTE_OFFSET] - 33) +
             abs(m3_test_lifecycle_active_count() - 2);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 2) + m3_test_lifecycle_active_count();
    m3_test_near(12117, error, 0, 0);
  );
);

function m3_test_host_seed_active(note, velocity)
local(cell) (
  cell = M3_VOICE_BASE + note * M3_VOICE_CELL_SIZE;
  m3_lifecycle_clear_voice(cell);
  cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ON;
  cell[M3_VOICE_STATE_ENTER_OFFSET] = 1;
  cell[M3_VOICE_VELOCITY_OFFSET] = velocity;
  cell[M3_VOICE_ACTIVE_OFFSET] = 1;
);

function m3_test_host_case(test_sr, test_block_size, case_id)
local(error, encoded, event, second_event, count, reason, captured_count,
      captured_type, captured_note, captured_offset, index, active_count,
      attack_samples, release_samples, dropout_samples, attack_time,
      first_count, second_count, selected_count, general_low, general_high,
      other_rate) (
  case_id == 9101 ? (
    m3_test_lifecycle_reset();
    m3_lifecycle_queue_event(
      M3_EVENT_BASE, M3_EVENT_TYPE_ON, 60, 100, 17
    );
    encoded = m3_midi_encode_event(
      M3_EVENT_BASE, 0, 1, test_block_size, M3_TEST_MIDI_ENCODE_BASE
    );
    error = abs(encoded - 1) +
            abs(M3_TEST_MIDI_ENCODE_BASE[0] - 0x90) +
            abs(M3_TEST_MIDI_ENCODE_BASE[1] - 60) +
            abs(M3_TEST_MIDI_ENCODE_BASE[2] - 100) +
            abs(M3_TEST_MIDI_ENCODE_BASE[3] - 17);
    m3_test_near(9101, error, 0, 0);
  );

  case_id == 9102 ? (
    m3_test_lifecycle_reset();
    m3_lifecycle_queue_event(
      M3_EVENT_BASE, M3_EVENT_TYPE_OFF, 60, 100, 0
    );
    encoded = m3_midi_encode_event(
      M3_EVENT_BASE, 0, 16, test_block_size, M3_TEST_MIDI_ENCODE_BASE
    );
    error = abs(encoded - 1) +
            abs(M3_TEST_MIDI_ENCODE_BASE[0] - 0x8F) +
            abs(M3_TEST_MIDI_ENCODE_BASE[1] - 60) +
            abs(M3_TEST_MIDI_ENCODE_BASE[2]) +
            abs(M3_TEST_MIDI_ENCODE_BASE[3]);
    m3_test_near(9102, error, 0, 0);
  );

  case_id == 9103 ? (
    m3_test_lifecycle_reset();
    m3_lifecycle_queue_event(
      M3_EVENT_BASE, M3_EVENT_TYPE_ON, 60, 100, -7
    );
    m3_lifecycle_queue_event(
      M3_EVENT_BASE, M3_EVENT_TYPE_OFF, 60, 0, test_block_size + 7
    );
    m3_midi_encode_event(
      M3_EVENT_BASE, 0, 1, test_block_size, M3_TEST_MIDI_ENCODE_BASE
    );
    m3_midi_encode_event(
      M3_EVENT_BASE, 1, 1, test_block_size, M3_TEST_MIDI_ENCODE_BASE + 4
    );
    error = abs(M3_TEST_MIDI_ENCODE_BASE[3]) +
            abs(M3_TEST_MIDI_ENCODE_BASE[7] - (test_block_size - 1));
    m3_test_near(9103, error, 0, 0);
  );

  case_id == 9104 ? (
    m3_test_lifecycle_reset();
    m3_test_host_seed_active(60, 100);
    other_rate = test_sr == 44100 ? 48000 : 44100;
    reason = m3_host_cleanup_reason(test_sr, other_rate, 1, 1, 0, 0);
    count = m3_midi_queue_panic(M3_VOICE_BASE, M3_EVENT_BASE, 0);
    event = m3_test_lifecycle_event(0);
    captured_count = count;
    captured_type = event[M3_EVENT_TYPE_OFFSET];
    captured_note = event[M3_EVENT_NOTE_OFFSET];
    captured_offset = event[M3_EVENT_SAMPLE_OFFSET];
    M3_CONDITION_BASE[12] = 123;
    M3_SELECTION_BASE[0] = 60;
    m3_host_reset_detector(other_rate, 32, 84, 440);
    error = abs(reason - 1) + abs(captured_count - 1) +
            abs(captured_type - M3_EVENT_TYPE_OFF) +
            abs(captured_note - 60) + abs(captured_offset) +
            m3_test_lifecycle_active_count() +
            abs(M3_CONDITION_BASE[12]) + abs(M3_SELECTION_BASE[0]) +
            abs(M3_RESONATOR_BASE[0] - other_rate);
    m3_test_near(9104, error, 0, 0);
  );

  case_id == 9105 ? (
    m3_test_lifecycle_reset();
    m3_test_host_seed_active(60, 100);
    m3_test_host_seed_active(64, 90);
    reason = m3_host_cleanup_reason(test_sr, test_sr, 1, 0, 0, 0);
    reason += m3_host_cleanup_reason(test_sr, test_sr, 5, 6, 0, 0);
    count = m3_midi_queue_panic(M3_VOICE_BASE, M3_EVENT_BASE, 0);
    error = abs(reason - 4) + abs(count - 2) +
            m3_test_lifecycle_active_count();
    index = 0;
    loop(count,
      event = m3_test_lifecycle_event(index);
      error += abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_OFF) +
               abs(event[M3_EVENT_SAMPLE_OFFSET]);
      index += 1;
    );
    m3_test_near(9105, error, 0, 0);
  );

  case_id == 9106 ? (
    m3_test_lifecycle_reset();
    m3_test_host_seed_active(60, 100);
    reason = m3_host_cleanup_reason(test_sr, test_sr, 1, 1, 0, 1);
    count = m3_midi_queue_panic(M3_VOICE_BASE, M3_EVENT_BASE, 0);
    event = m3_test_lifecycle_event(0);
    captured_count = count;
    captured_type = event[M3_EVENT_TYPE_OFFSET];
    captured_note = event[M3_EVENT_NOTE_OFFSET];
    M3_CONDITION_BASE[8] = 123;
    M3_SALIENCE_BASE[0] = 456;
    M3_SALIENCE_BASE[M3_SALIENCE_CLIPPED_OFFSET] = 654;
    M3_SALIENCE_BASE[M3_SALIENCE_EFFECTIVE_THRESHOLD_OFFSET] = 987;
    M3_SELECTION_BASE[0] = 60;
    M3_M3_SCRATCH_BASE[0] = 789;
    m3_host_reset_detector(test_sr, 32, 84, 440);
    error = abs(reason - 8) + abs(captured_count - 1) +
            abs(captured_type - M3_EVENT_TYPE_OFF) +
            abs(captured_note - 60) +
            m3_test_lifecycle_active_count() +
            abs(M3_CONDITION_BASE[8]) + abs(M3_SALIENCE_BASE[0]) +
            abs(M3_SALIENCE_BASE[M3_SALIENCE_CLIPPED_OFFSET]) +
            abs(M3_SALIENCE_BASE[
              M3_SALIENCE_EFFECTIVE_THRESHOLD_OFFSET
            ]) +
            abs(M3_SELECTION_BASE[0]) + abs(M3_M3_SCRATCH_BASE[0]);
    m3_test_near(9106, error, 0, 0);
  );

  case_id == 9107 ? (
    m3_test_lifecycle_reset();
    m3_lifecycle_response(
      0,
      test_sr,
      0.20,
      M3_TEST_LIFECYCLE_RESPONSE_BASE
    );
    attack_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
      M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET
    ];
    release_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
      M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET
    ];
    dropout_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
      M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET
    ];
    attack_time = m3_test_lifecycle_boundary(attack_samples, test_block_size);
    m3_test_lifecycle_select(0, 60, 0.80, 0.25);
    m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 100
    );
    first_count = m3_test_lifecycle_update_default(
      1, attack_time, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 100
    );
    m3_midi_encode_event(
      M3_EVENT_BASE, 0, 1, test_block_size, M3_TEST_MIDI_ENCODE_BASE
    );
    second_count = m3_test_lifecycle_update_default(
      1, attack_time + test_block_size, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 100
    );
    active_count = m3_test_lifecycle_active_count();
    m3_lifecycle_release_all(M3_VOICE_BASE, M3_EVENT_BASE, 0);
    error = abs(first_count - 1) + abs(second_count) +
            abs(active_count - 1) +
            abs(M3_TEST_MIDI_ENCODE_BASE[0] - 0x90);
    m3_test_near(9107, error, 0, 0);
  );

  case_id == 9108 ? (
    error = abs(m3_host_select_input(0, 0.25, -0.50) - 0.25) +
            abs(m3_host_select_input(1, 0.25, -0.50) + 0.50) +
            abs(
              m3_host_select_input(2, 0.25, -0.50) +
              0.25 * 0.7071067811865476
            ) +
            abs(m3_host_signal_present(0)) +
            abs(m3_host_signal_present(
              M3_HOST_MIN_SIGNAL_ENERGY * 0.5
            )) +
            abs(m3_host_signal_present(M3_HOST_MIN_SIGNAL_ENERGY) - 1) +
            abs(m3_host_signal_present(
              M3_HOST_MIN_SIGNAL_ENERGY * 2
            ) - 1) +
            abs(m3_host_panic_hold_next(0, 1, 0) - 1) +
            abs(m3_host_panic_hold_next(
              1, 0, M3_HOST_PANIC_RELEASE_PEAK * 2
            ) - 1) +
            abs(m3_host_panic_hold_next(
              1, 0, M3_HOST_PANIC_RELEASE_PEAK * 0.5
            )) +
            abs(m3_host_panic_hold_next(
              0, 0, M3_HOST_PANIC_RELEASE_PEAK * 2
            ));
    m3_test_near(9108, error, 0, 0.000000001);
  );

  case_id == 9109 ? (
    m3_host_apply_bounds(
      M3_PROFILE_MODE_M3, 24, 108, M3_TEST_BOUNDS_BASE
    );
    error = abs(M3_TEST_BOUNDS_BASE[0] - 32) +
            abs(M3_TEST_BOUNDS_BASE[1] - 84);
    m3_host_apply_bounds(
      M3_PROFILE_MODE_GENERAL, 120, 12, M3_TEST_BOUNDS_BASE
    );
    general_low = M3_TEST_BOUNDS_BASE[0];
    general_high = M3_TEST_BOUNDS_BASE[1];
    reason = m3_host_cleanup_reason(test_sr, test_sr, 1, 1, 1, 0);
    error += abs(general_low - 24) + abs(general_high - 108) +
             abs(reason - 4);
    m3_test_near(9109, error, 0, 0);
  );
);

function m3_test_telemetry_reset() (
  m3_zero(M3_TEST_TELEMETRY_SOURCE_BASE, M3_TELEMETRY_WORDS);
  m3_zero(M3_TEST_TELEMETRY_UI_BASE, M3_TELEMETRY_WORDS);
  m3_zero(M3_TEST_SERIALIZATION_BASE, 8);
  m3_test_lifecycle_reset();
);

function m3_test_telemetry_case(test_sr, case_id)
local(accepted, valid, generation, active_count, index, note, cell, fault,
      cleanup_count, word_count, detection_enabled, dry_sample, error) (
  case_id == 10101 ? (
    m3_test_telemetry_reset();
    M3_TEST_TELEMETRY_SOURCE_BASE[M3_TELEMETRY_GENERATION_OFFSET] = 3;
    M3_TEST_TELEMETRY_UI_BASE[M3_TELEMETRY_GENERATION_OFFSET] = 88;
    accepted = m3_telemetry_read(
      M3_TEST_TELEMETRY_SOURCE_BASE,
      M3_TEST_TELEMETRY_UI_BASE
    );
    error = accepted + m3_telemetry_generation_valid(3, 3) + abs(
      M3_TEST_TELEMETRY_UI_BASE[M3_TELEMETRY_GENERATION_OFFSET] - 88
    );
    m3_test_near(10101, error, 0, 0);
  );

  case_id == 10102 ? (
    m3_test_telemetry_reset();
    valid = m3_telemetry_generation_valid(2, 4);
    error = valid +
            abs(m3_telemetry_generation_valid(2, 2) - 1) +
            m3_telemetry_generation_valid(0, 0);
    m3_test_near(10102, error, 0, 0);
  );

  case_id == 10103 ? (
    m3_test_telemetry_reset();
    index = 0;
    loop(10,
      note = 40 + index;
      m3_test_host_seed_active(note, 80 + index);
      cell = M3_VOICE_BASE + note * M3_VOICE_CELL_SIZE;
      cell[M3_VOICE_CONFIDENCE_OFFSET] = 0.90 - index * 0.01;
      cell[M3_VOICE_FIRST_EVIDENCE_OFFSET] = index * 10;
      index += 1;
    );
    absolute_sample = 1000;
    generation = m3_telemetry_publish(
      M3_TEST_TELEMETRY_SOURCE_BASE,
      0,
      M3_FAULT_OK,
      0,
      0.75,
      0.01,
      0,
      1.25,
      M3_VOICE_BASE
    );
    accepted = m3_telemetry_read(
      M3_TEST_TELEMETRY_SOURCE_BASE,
      M3_TEST_TELEMETRY_UI_BASE
    );
    active_count = M3_TEST_TELEMETRY_UI_BASE[
      M3_TELEMETRY_ACTIVE_COUNT_OFFSET
    ];
    error = max(0, active_count - M3_TELEMETRY_MAX_NOTES) +
            abs(active_count - M3_TELEMETRY_MAX_NOTES) +
            abs(accepted - 1) + (generation <= 0 ? 1 : 0);
    m3_test_near(10103, error, 0, 0);
  );

  case_id == 10104 ? (
    m3_test_telemetry_reset();
    m3_test_host_seed_active(60, 100);
    fault = m3_host_fault_code(2, 1, 0, 0, 1);
    cleanup_count = m3_host_fault_cleanup(
      fault,
      M3_VOICE_BASE,
      M3_EVENT_BASE,
      0
    );
    generation = m3_telemetry_publish(
      M3_TEST_TELEMETRY_SOURCE_BASE,
      0,
      fault,
      0,
      1,
      0,
      1,
      0,
      M3_VOICE_BASE
    );
    accepted = m3_telemetry_read(
      M3_TEST_TELEMETRY_SOURCE_BASE,
      M3_TEST_TELEMETRY_UI_BASE
    );
    error = abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    error += abs(fault - M3_FAULT_INVALID_SAMPLES) + abs(
      accepted * M3_TEST_TELEMETRY_UI_BASE[M3_TELEMETRY_FAULT_OFFSET] -
      M3_FAULT_INVALID_SAMPLES
    );
    m3_test_near(10104, error, 0, 0);
  );

  case_id == 10105 ? (
    m3_test_telemetry_reset();
    m3_test_host_seed_active(60, 101);
    M3_TEST_SERIALIZATION_BASE[1] = 97531;
    word_count = m3_state_prepare_serialization(
      1,
      M3_TEST_SERIALIZATION_BASE
    );
    error = abs(word_count - 1) +
            abs(M3_TEST_SERIALIZATION_BASE[0] - 1) +
            abs(M3_TEST_SERIALIZATION_BASE[1] - 97531);
    m3_test_near(10105, error, 0, 0);
  );

  case_id == 10106 ? (
    fault = m3_host_fault_code(3, 0, 0, 0, 1);
    detection_enabled = m3_host_detection_enabled(3, fault);
    dry_sample = m3_host_available_dry(0.25, 1);
    error = abs(fault - M3_FAULT_UNSUPPORTED_CHANNELS) +
            abs(detection_enabled) + abs(dry_sample - 0.25);
    m3_test_near(10106, error, 0, 0);
  );
);

gmem[0] = M3_TEST_MAGIC;
gmem[1] = 1;
gmem[2] = 0;
gmem[3] = 0;
gmem[4] = 0;
gmem[5] = 0;
gmem[7] = 0;
gmem[8] = 0;
gmem[9] = 0;
gmem[10] = 0;
gmem[11] = 0;
gmem[12] = 0;
gmem[13] = 0;
gmem[14] = 0;
test_diagnostic_index = 16;
loop(229,
  gmem[test_diagnostic_index] = 0;
  test_diagnostic_index += 1;
);
test_bank_rate = slider1 == 1 ? 44100 : slider1 == 2 ? 96000 : 48000;
test_block_size = slider3 == 0 ? 32
                : slider3 == 1 ? 64
                : slider3 == 2 ? 128
                : 256;
test_case_index = min(67, max(0, slider2|0));
test_bank_case_id = test_case_index < 6
  ? 4101 + test_case_index
  : test_case_index < 12
    ? 5101 + test_case_index - 6
    : test_case_index < 18
      ? 6101 + test_case_index - 12
      : test_case_index < 24
        ? 7101 + test_case_index - 18
        : test_case_index < 35
          ? 8101 + test_case_index - 24
          : test_case_index < 44
            ? 9101 + test_case_index - 35
            : test_case_index < 50
              ? 10101 + test_case_index - 44
              : 12101 + test_case_index - 50;
gmem[6] = test_bank_rate;
gmem[15] = test_bank_case_id;
gmem[30] = test_block_size;

m3_test_near(2101, m3_midi_to_hz(69, 440), 440, 0.000001);
m3_test_near(2102, m3_midi_to_hz(32, 440), 51.9131, 0.01);
test_bank_case_id == 4101 ? (
  m3_test_condition_rate(48000);
  m3_test_condition_rate(44100);
  m3_test_condition_rate(96000);
);
test_bank_case_id < 5000 ? (
  m3_test_bank_case(test_bank_rate, test_bank_case_id);
) : test_bank_case_id < 6000 ? (
  m3_test_selection_case(test_bank_rate, test_bank_case_id);
) : test_bank_case_id < 7000 ? (
  m3_test_multi_rate_case(test_bank_rate, test_bank_case_id);
) : test_bank_case_id < 8000 ? (
  m3_test_profile_case(test_bank_case_id);
) : test_bank_case_id < 9000 ? (
  m3_test_lifecycle_case(
    test_bank_rate,
    test_block_size,
    test_bank_case_id
  );
) : test_bank_case_id < 10000 ? (
  m3_test_host_case(
    test_bank_rate,
    test_block_size,
    test_bank_case_id
  );
) : test_bank_case_id < 11000 ? (
  m3_test_telemetry_case(test_bank_rate, test_bank_case_id);
  ) : (test_bank_case_id >= 12101 && test_bank_case_id <= 12103) ||
      (test_bank_case_id >= 12107 && test_bank_case_id <= 12108) ||
      test_bank_case_id == 12113 ||
      (test_bank_case_id >= 12115 && test_bank_case_id <= 12116) ||
      test_bank_case_id == 12118 ? (
    m3_test_selection_case(test_bank_rate, test_bank_case_id);
  ) : (
    m3_test_task_twelve_lifecycle_case(
      test_bank_rate,
      test_block_size,
      test_bank_case_id
    );
  );
gmem[1] == 1 ? gmem[1] = 2;

@gfx 440 220
gfx_set(0.80, 0.84, 0.90, 1);
gfx_x = 16;
gfx_y = 16;
gmem[1] == 2 ? gfx_drawstr("PASS") :
gmem[1] == -1 ? gfx_drawstr("FAIL") : gfx_drawstr("RUNNING");
gfx_x = 16;
gfx_y = 44;
gfx_printf("Assertions: %d", gmem[2]);
gfx_x = 16;
gfx_y = 68;

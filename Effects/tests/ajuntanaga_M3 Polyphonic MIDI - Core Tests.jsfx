function m3_test_rate_voice(index, note, gain) (
  M3_TEST_RATE_NOTE_BASE[index] = note;
  M3_TEST_RATE_GAIN_BASE[index] = gain;
);

function m3_test_rate_case_setup(case_index) (
  m3_zero(M3_TEST_RATE_NOTE_BASE, 8);
  m3_zero(M3_TEST_RATE_GAIN_BASE, 8);
  test_rate_max_voices = 8;
  test_rate_voice_count = 0;

  case_index == 0 ? (
    m3_test_rate_voice(0, 40, 1);
    test_rate_voice_count = 1;
  );
  case_index == 1 ? (
    m3_test_rate_voice(0, 40, 1);
    m3_test_rate_voice(1, 47, 0.71);
    test_rate_voice_count = 2;
  );
  case_index == 2 ? (
    m3_test_rate_voice(0, 32, 1);
    m3_test_rate_voice(1, 36, 0.79);
    m3_test_rate_voice(2, 40, 0.63);
    test_rate_voice_count = 3;
  );
  case_index == 3 || case_index == 5 ? (
    m3_test_rate_voice(0, 32, 1);
    m3_test_rate_voice(1, 36, 1);
    m3_test_rate_voice(2, 40, 1);
    m3_test_rate_voice(3, 44, 1);
    m3_test_rate_voice(4, 48, 1);
    m3_test_rate_voice(5, 52, 1);
    m3_test_rate_voice(6, 56, 1);
    m3_test_rate_voice(7, 60, 1);
    test_rate_voice_count = 8;
    case_index == 5 ? test_rate_max_voices = 3;
  );
  case_index == 4 ? (
    m3_test_rate_voice(0, 40, 1);
    m3_test_rate_voice(1, 47, 0.50);
    m3_test_rate_voice(2, 52, 10 ^ (-24 / 20));
    m3_test_rate_voice(3, 57, 0.25);
    test_rate_voice_count = 4;
  );
  test_rate_voice_count;
);

function m3_test_rate_process_pair(test_sr, voice_count, duration,
                                   test_min_note, test_max_note)
local(sample_index, sample_count, attack_samples, attack, voice, phase,
      phase_step, sample) (
  m3_bank_init(
    M3_RESONATOR_BASE,
    test_sr,
    test_min_note,
    test_max_note,
    440
  );
  m3_bank_init_reference(
    M3_TEST_REFERENCE_BANK_BASE,
    test_sr,
    test_min_note,
    test_max_note,
    440
  );
  m3_zero(M3_TEST_RATE_PHASE_BASE, 8);
  sample_index = 0;
  sample_count = floor(duration * test_sr);
  attack_samples = max(1, floor(0.005 * test_sr));
  loop(sample_count,
    attack = sample_index < attack_samples
           ? 0.5 - 0.5 * cos($pi * sample_index / attack_samples)
           : 1;
    sample = 0;
    voice = 0;
    loop(voice_count,
      phase = M3_TEST_RATE_PHASE_BASE[voice];
      sample += M3_TEST_RATE_GAIN_BASE[voice] * (
        sin(phase) +
        0.50 * sin(2 * phase) +
        0.32 * sin(3 * phase) +
        0.22 * sin(4 * phase)
      );
      phase_step = 2 * $pi * m3_midi_to_hz(
        M3_TEST_RATE_NOTE_BASE[voice],
        440
      ) / test_sr;
      phase += phase_step;
      phase >= 2 * $pi ? phase -= 2 * $pi;
      M3_TEST_RATE_PHASE_BASE[voice] = phase;
      voice += 1;
    );
    sample *= attack * 0.29 / max(1, voice_count);
    m3_bank_process(M3_RESONATOR_BASE, sample);
    m3_bank_process_reference(M3_TEST_REFERENCE_BANK_BASE, sample);
    sample_index += 1;
  );
  m3_salience_update(
    M3_RESONATOR_BASE,
    M3_SALIENCE_BASE,
    0.00001
  );
  m3_salience_update(
    M3_TEST_REFERENCE_BANK_BASE,
    M3_TEST_REFERENCE_SALIENCE_BASE,
    0.00001
  );
);

function m3_test_rate_selection_error(test_min_note, test_max_note, max_voices)
local(candidate_count, production_count, reference_count, index, error) (
  candidate_count = test_max_note - test_min_note + 1;
  production_count = m3_select_voices(
    M3_RESONATOR_BASE,
    M3_SALIENCE_BASE,
    test_min_note,
    candidate_count,
    0.20,
    max_voices,
    440,
    M3_SELECTION_GENERAL_LOCAL_ENERGY_RATIO,
    1,
    test_block_size,
    test_bank_rate,
    M3_SELECTION_BASE
  );
  reference_count = m3_select_voices(
    M3_TEST_REFERENCE_BANK_BASE,
    M3_TEST_REFERENCE_SALIENCE_BASE,
    test_min_note,
    candidate_count,
    0.20,
    max_voices,
    440,
    M3_SELECTION_GENERAL_LOCAL_ENERGY_RATIO,
    1,
    test_block_size,
    test_bank_rate,
    M3_TEST_REFERENCE_SELECTION_BASE
  );
  test_rate_last_production_count = production_count;
  test_rate_last_reference_count = reference_count;
  test_rate_last_production_note = M3_SELECTION_BASE[0];
  test_rate_last_reference_note = M3_TEST_REFERENCE_SELECTION_BASE[0];
  error = abs(production_count - reference_count);
  index = 0;
  loop(M3_MAX_VOICES,
    error += abs(
      M3_SELECTION_BASE[index * M3_SELECTION_CELL_SIZE] -
      M3_TEST_REFERENCE_SELECTION_BASE[index * M3_SELECTION_CELL_SIZE]
    );
    index += 1;
  );
  error;
);

function m3_test_rate_alias_score(test_sr, frequency)
local(sample_index, sample_count, attack_samples, attack, phase, phase_step,
      candidate, last_candidate, score) (
  m3_bank_init(M3_RESONATOR_BASE, test_sr, 24, 60, 440);
  sample_index = 0;
  sample_count = floor(0.300 * test_sr);
  attack_samples = max(1, floor(0.005 * test_sr));
  phase = 0;
  phase_step = 2 * $pi * frequency / test_sr;
  loop(sample_count,
    attack = sample_index < attack_samples
           ? 0.5 - 0.5 * cos($pi * sample_index / attack_samples)
           : 1;
    m3_bank_process(M3_RESONATOR_BASE, attack * 0.80 * sin(phase));
    phase += phase_step;
    phase >= 2 * $pi ? phase -= 2 * $pi;
    sample_index += 1;
  );
  m3_salience_update(
    M3_RESONATOR_BASE,
    M3_SALIENCE_BASE,
    0.00001
  );
  candidate = M3_RESONATOR_BASE[10];
  last_candidate = M3_RESONATOR_BASE[11];
  score = 0;
  loop(last_candidate - candidate + 1,
    score = max(score, M3_SALIENCE_BASE[candidate]);
    candidate += 1;
  );
  score;
);

function m3_test_rate_enabled_cells(bank_base)
local(candidate, harmonic, enabled) (
  candidate = 0;
  enabled = 0;
  loop(bank_base[4],
    harmonic = 0;
    loop(M3_MAX_HARMONICS,
      m3_bank_enabled(bank_base, candidate, harmonic) ? enabled += 1;
      harmonic += 1;
    );
    candidate += 1;
  );
  enabled;
);

function m3_test_multi_rate_case(test_sr, case_id)
local(index, note, production_index, reference_index, delta, max_delta,
      variant, voice_count, selection_error, alias_score, sample_count,
      average_updates, enabled_cells, guard_error, selected_count,
      parent_probe_excess, work_measure) (
  case_id == 6101 ? (
    voice_count = m3_test_rate_case_setup(3);
    m3_test_rate_process_pair(test_sr, voice_count, 0.300, 32, 60);
    index = 0;
    max_delta = 0;
    loop(8,
      note = M3_TEST_RATE_NOTE_BASE[index];
      production_index = note - M3_RESONATOR_BASE[1];
      reference_index = note - M3_TEST_REFERENCE_BANK_BASE[1];
      delta = abs(
        M3_SALIENCE_BASE[production_index] -
        M3_TEST_REFERENCE_SALIENCE_BASE[reference_index]
      );
      delta > max_delta ? (
        max_delta = delta;
        gmem[10] = note;
        gmem[11] = M3_SALIENCE_BASE[production_index];
        gmem[12] = M3_TEST_REFERENCE_SALIENCE_BASE[reference_index];
      );
      gmem[16 + index] = M3_SALIENCE_BASE[production_index];
      gmem[24 + index] = M3_TEST_REFERENCE_SALIENCE_BASE[reference_index];
      index += 1;
    );
    gmem[7] = max_delta;
    m3_test_lte(6101, max_delta, 0.03);
  );

  case_id == 6102 ? (
    variant = 0;
    selection_error = 0;
    loop(6,
      voice_count = m3_test_rate_case_setup(variant);
      m3_test_rate_process_pair(test_sr, voice_count, 0.150, 32, 72);
      delta = m3_test_rate_selection_error(
        32,
        72,
        min(test_rate_max_voices, voice_count)
      );
      selection_error += delta;
      delta > 0 ? (
        gmem[10] = variant;
        gmem[11] = test_rate_last_production_count;
        gmem[12] = test_rate_last_reference_count;
        gmem[13] = test_rate_last_production_note;
        gmem[14] = test_rate_last_reference_note;
        index = 0;
        loop(M3_MAX_VOICES,
          gmem[16 + index] =
            M3_SELECTION_BASE[index * M3_SELECTION_CELL_SIZE];
          gmem[24 + index] =
            M3_TEST_REFERENCE_SELECTION_BASE[index * M3_SELECTION_CELL_SIZE];
          index += 1;
        );
      );
      variant += 1;
    );
    m3_test_near(6102, selection_error, 0, 0);
  );

  case_id == 6103 ? (
    alias_score = m3_test_rate_alias_score(
      test_sr,
      17000 * test_sr / 48000
    );
    m3_test_lte(6103, alias_score, 0.20);
  );

  case_id == 6104 ? (
    alias_score = m3_test_rate_alias_score(
      test_sr,
      21000 * test_sr / 96000
    );
    m3_test_lte(6104, alias_score, 0.20);
  );

  case_id == 6105 ? (
    m3_bank_init(M3_RESONATOR_BASE, 48000, 32, 84, 440);
    enabled_cells = m3_test_rate_enabled_cells(M3_RESONATOR_BASE);
    sample_count = 64;
    loop(sample_count,
      m3_bank_process(M3_RESONATOR_BASE, 0);
    );
    average_updates = M3_RATE_BASE[M3_RATE_CELL_UPDATES_OFFSET] /
                      max(1, M3_RATE_BASE[M3_RATE_INPUT_SAMPLES_OFFSET]);
    index = 0;
    loop(53,
      M3_SALIENCE_BASE[index] = 0.50;
      m3_test_fixture_harmonic(32 + index, 0, 1.00);
      index += 1;
    );
    m3_selection_shared_parent_probes = 999999;
    selected_count = m3_select_voices(
      M3_RESONATOR_BASE,
      M3_SALIENCE_BASE,
      32,
      53,
      0.20,
      8,
      440,
      1.00,
      1,
      test_block_size,
      48000,
      M3_SELECTION_BASE
    );
    parent_probe_excess = max(
      0,
      m3_selection_shared_parent_probes - 53 * 5
    );
    work_measure = max(
      average_updates,
      45 + parent_probe_excess + abs(selected_count - 8)
    );
    gmem[8] = average_updates;
    gmem[9] = enabled_cells;
    gmem[10] = m3_selection_shared_parent_probes;
    gmem[11] = selected_count;
    m3_test_lte(6105, work_measure, 45);
  );

  case_id == 6106 ? (
    m3_bank_init(M3_RESONATOR_BASE, test_sr, 32, 84, 440);
    M3_RATE_BASE[M3_RATE_GUARD_LOW_OFFSET] = 1234567;
    M3_RATE_BASE[M3_RATE_GUARD_HIGH_OFFSET] = 7654321;
    sample_count = 64;
    loop(sample_count,
      m3_bank_process(M3_RESONATOR_BASE, 0.125);
    );
    guard_error = abs(
      M3_RATE_BASE[M3_RATE_GUARD_LOW_OFFSET] - 1234567
    ) + abs(
      M3_RATE_BASE[M3_RATE_GUARD_HIGH_OFFSET] - 7654321
    );
    m3_test_near(6106, guard_error, 0, 0);
  );
);

function m3_test_profile_guard_start() (
  M3_M3_SCRATCH_BASE[-1] = 1234567;
  M3_M3_SCRATCH_BASE[768] = 7654321;
);

function m3_test_profile_guard_error() (
  abs(M3_M3_SCRATCH_BASE[-1] - 1234567) +
  abs(M3_M3_SCRATCH_BASE[768] - 7654321);
);

function m3_test_profile_open_error(open_base) (
  abs(open_base[0] - M3_M3_OPEN_0) +
  abs(open_base[1] - M3_M3_OPEN_1) +
  abs(open_base[2] - M3_M3_OPEN_2) +
  abs(open_base[3] - M3_M3_OPEN_3) +
  abs(open_base[4] - M3_M3_OPEN_4) +
  abs(open_base[5] - M3_M3_OPEN_5) +
  abs(open_base[6] - M3_M3_OPEN_6) +
  abs(open_base[7] - M3_M3_OPEN_7);
);

function m3_test_profile_case(case_id)
local(index, feasible, error, selected_count) (
  m3_zero(M3_TEST_PROFILE_OPEN_BASE, 8);
  m3_zero(M3_TEST_PROFILE_NOTE_BASE, 8);
  m3_profile_load(M3_TEST_PROFILE_OPEN_BASE);

  case_id == 7101 ? (
    m3_test_near(
      7101,
      m3_test_profile_open_error(M3_TEST_PROFILE_OPEN_BASE),
      0,
      0
    );
  );

  case_id == 7102 ? (
    index = 0;
    loop(8,
      M3_TEST_PROFILE_NOTE_BASE[index] = M3_TEST_PROFILE_OPEN_BASE[index];
      index += 1;
    );
    m3_test_profile_guard_start();
    feasible = m3_voicing_feasible(
      M3_TEST_PROFILE_NOTE_BASE,
      8,
      0,
      M3_M3_SCRATCH_BASE
    );
    error = abs(feasible - 1) + m3_test_profile_guard_error();
    m3_test_near(7102, error, 0, 0);
  );

  case_id == 7103 ? (
    index = 0;
    loop(8,
      M3_TEST_PROFILE_NOTE_BASE[index] = 32 + index;
      index += 1;
    );
    m3_test_profile_guard_start();
    feasible = m3_voicing_feasible(
      M3_TEST_PROFILE_NOTE_BASE,
      8,
      24,
      M3_M3_SCRATCH_BASE
    );
    error = abs(feasible) + m3_test_profile_guard_error();
    m3_test_near(7103, error, 0, 0);
  );

  case_id == 7104 ? (
    M3_TEST_PROFILE_NOTE_BASE[0] = 44;
    M3_TEST_PROFILE_NOTE_BASE[1] = 48;
    M3_TEST_PROFILE_NOTE_BASE[2] = 52;
    M3_TEST_PROFILE_NOTE_BASE[3] = 56;
    m3_test_profile_guard_start();
    feasible = m3_voicing_feasible(
      M3_TEST_PROFILE_NOTE_BASE,
      4,
      24,
      M3_M3_SCRATCH_BASE
    );
    error = abs(feasible - 1) + m3_test_profile_guard_error();

    m3_zero(M3_SELECTION_BASE, M3_SELECTION_RESULT_WORDS);
    M3_SELECTION_BASE[0] = 32;
    M3_SELECTION_BASE[1] = 0.40;
    M3_SELECTION_BASE[4] = 36;
    M3_SELECTION_BASE[5] = 0.40;
    M3_SELECTION_BASE[8] = 41;
    M3_SELECTION_BASE[9] = 0.30;
    selected_count = m3_profile_filter_selected(
      M3_PROFILE_MODE_M3,
      M3_SELECTION_BASE,
      3,
      M3_MAX_VOICES,
      24,
      M3_TEST_PROFILE_NOTE_BASE,
      M3_M3_SCRATCH_BASE
    );
    error += abs(selected_count - 2) +
             abs(M3_SELECTION_BASE[0] - 32) +
             abs(M3_SELECTION_BASE[4] - 36);

    m3_zero(M3_SELECTION_BASE, M3_SELECTION_RESULT_WORDS);
    M3_SELECTION_BASE[0] = 32;
    M3_SELECTION_BASE[1] = 0.40;
    M3_SELECTION_BASE[4] = 36;
    M3_SELECTION_BASE[5] = 0.40;
    M3_SELECTION_BASE[8] = 41;
    M3_SELECTION_BASE[9] = 0.65;
    selected_count = m3_profile_filter_selected(
      M3_PROFILE_MODE_M3,
      M3_SELECTION_BASE,
      3,
      M3_MAX_VOICES,
      24,
      M3_TEST_PROFILE_NOTE_BASE,
      M3_M3_SCRATCH_BASE
    );
    error += abs(selected_count - 3) +
             abs(M3_SELECTION_BASE[0] - 32) +
             abs(M3_SELECTION_BASE[4] - 36) +
             abs(M3_SELECTION_BASE[8] - 41);

    m3_zero(M3_SELECTION_BASE, M3_SELECTION_RESULT_WORDS);
    M3_SELECTION_BASE[0] = 64;
    M3_SELECTION_BASE[1] = 0.50;
    selected_count = m3_profile_filter_selected(
      M3_PROFILE_MODE_M3,
      M3_SELECTION_BASE,
      1,
      M3_MAX_VOICES,
      24,
      M3_TEST_PROFILE_NOTE_BASE,
      M3_M3_SCRATCH_BASE
    );
    error += selected_count;

    m3_zero(M3_SELECTION_BASE, M3_SELECTION_RESULT_WORDS);
    M3_SELECTION_BASE[0] = 64;
    M3_SELECTION_BASE[1] = 0.65;
    selected_count = m3_profile_filter_selected(
      M3_PROFILE_MODE_M3,
      M3_SELECTION_BASE,
      1,
      M3_MAX_VOICES,
      24,
      M3_TEST_PROFILE_NOTE_BASE,
      M3_M3_SCRATCH_BASE
    );
    error += abs(selected_count - 1) +
             abs(M3_SELECTION_BASE[0] - 64);
    m3_test_near(7104, error, 0, 0);
  );

  case_id == 7105 ? (
    M3_TEST_PROFILE_NOTE_BASE[0] = 31;
    m3_test_profile_guard_start();
    feasible = m3_voicing_feasible(
      M3_TEST_PROFILE_NOTE_BASE,
      1,
      24,
      M3_M3_SCRATCH_BASE
    );
    M3_SELECTION_BASE[0] = 31;
    M3_SELECTION_BASE[1] = 0.25;
    M3_SELECTION_BASE[2] = 0.25;
    M3_SELECTION_BASE[3] = 0;
    M3_SELECTION_BASE[4] = 44;
    M3_SELECTION_BASE[5] = 0.90;
    M3_SELECTION_BASE[6] = 0.75;
    M3_SELECTION_BASE[7] = 0;
    selected_count = m3_profile_filter_selected(
      M3_PROFILE_MODE_M3,
      M3_SELECTION_BASE,
      2,
      M3_MAX_VOICES,
      24,
      M3_TEST_PROFILE_NOTE_BASE,
      M3_M3_SCRATCH_BASE
    );
    error = abs(feasible) +
            abs(selected_count - 1) +
            abs(M3_SELECTION_BASE[0] - 44) +
            m3_test_profile_guard_error();
    m3_test_near(7105, error, 0, 0);
  );

  case_id == 7106 ? (
    M3_SELECTION_BASE[0] = 31;
    M3_SELECTION_BASE[1] = 0.75;
    M3_SELECTION_BASE[2] = 0.50;
    M3_SELECTION_BASE[3] = 0;
    m3_test_profile_guard_start();
    selected_count = m3_profile_filter_selected(
      M3_PROFILE_MODE_GENERAL,
      M3_SELECTION_BASE,
      1,
      M3_MAX_VOICES,
      24,
      M3_TEST_PROFILE_NOTE_BASE,
      M3_M3_SCRATCH_BASE
    );
    error = abs(selected_count - 1) +
            abs(M3_SELECTION_BASE[0] - 31) +
            m3_test_profile_guard_error();
    m3_test_near(7106, error, 0, 0);
  );
);

function m3_test_lifecycle_reset() (
  m3_lifecycle_init(M3_VOICE_BASE, M3_EVENT_BASE);
  m3_lifecycle_attack_hysteresis = 0;
  m3_lifecycle_attack_bridge_samples = 0;
  m3_lifecycle_attack_evidence_step_samples = 0;
  m3_lifecycle_min_attack_energy = 0;
  m3_lifecycle_general_octave_guard = 0;
  m3_lifecycle_max_active_voices = M3_MAX_VOICES;
  m3_lifecycle_m3_low_string_guard = 0;
  m3_lifecycle_m3_low_open_fast_attack = 0;
  m3_lifecycle_reserve_lower_attacks = 0;
  m3_lifecycle_attack_admission = 1;
  m3_zero(
    M3_SELECTION_BASE,
    M3_MAX_VOICES * M3_SELECTION_CELL_SIZE
  );
);

function m3_test_lifecycle_select(index, note, confidence, energy)
local(cell) (
  cell = M3_SELECTION_BASE + index * M3_SELECTION_CELL_SIZE;
  cell[0] = note;
  cell[1] = confidence;
  cell[2] = energy;
  cell[3] = 0;
);

function m3_test_lifecycle_event(index) (
  M3_EVENT_BASE + M3_EVENT_HEADER_SIZE + index * M3_EVENT_CELL_SIZE;
);

function m3_test_lifecycle_active_count()
local(note, cell, count) (
  note = 0;
  count = 0;
  loop(128,
    cell = M3_VOICE_BASE + note * M3_VOICE_CELL_SIZE;
    cell[M3_VOICE_ACTIVE_OFFSET] ? count += 1;
    note += 1;
  );
  count;
);

function m3_test_lifecycle_event_type_count(event_type)
local(index, event, count) (
  index = 0;
  count = 0;
  loop(M3_EVENT_BASE[M3_EVENT_COUNT_OFFSET],
    event = m3_test_lifecycle_event(index);
    event[M3_EVENT_TYPE_OFFSET] == event_type ? count += 1;
    index += 1;
  );
  count;
);

function m3_test_lifecycle_boundary(sample_count, block_size) (
  floor((sample_count + block_size - 1) / block_size) * block_size;
);

function m3_test_lifecycle_update_default(selected_count, absolute_sample,
                                          block_offset, attack_samples,
                                          release_samples, dropout_samples,
                                          velocity_mode, fixed_velocity) (
  m3_lifecycle_update(
    M3_VOICE_BASE,
    M3_EVENT_BASE,
    M3_SELECTION_BASE,
    selected_count,
    absolute_sample,
    block_offset,
    attack_samples,
    release_samples,
    dropout_samples,
    M3_TEST_LIFECYCLE_RESPONSE_BASE[M3_LIFECYCLE_ON_THRESHOLD_OFFSET],
    M3_TEST_LIFECYCLE_RESPONSE_BASE[M3_LIFECYCLE_OFF_THRESHOLD_OFFSET],
    velocity_mode,
    fixed_velocity
  );
);

function m3_test_lifecycle_case(test_sr, test_block_size, case_id)
local(attack_samples, release_samples, dropout_samples, attack_time,
      release_time, event_offset, event_count, cleanup_count, error, event,
      second_event, old_cell, new_cell, index, transition_time,
      first_loss_time, off_time, off_count, on_count, velocity_low,
      velocity_high) (
  m3_lifecycle_response(
    0,
    test_sr,
    0.20,
    M3_TEST_LIFECYCLE_RESPONSE_BASE
  );
  attack_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
    M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET
  ];
  release_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
    M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET
  ];
  dropout_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
    M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET
  ];
  attack_time = m3_test_lifecycle_boundary(attack_samples, test_block_size);
  release_time = m3_test_lifecycle_boundary(release_samples, test_block_size);
  event_offset = max(0, test_block_size - 1);

  case_id == 8101 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 60, 0.51, 0.25);
    event_count = m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event_count += m3_test_lifecycle_update_default(
      1, attack_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 64
    );
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error = event_count + cleanup_count + m3_test_lifecycle_active_count() +
            abs(attack_samples - max(1, floor(0.004 * test_sr + 0.5))) +
            abs(release_samples - max(1, floor(0.018 * test_sr + 0.5))) +
            abs(dropout_samples - max(1, floor(0.006 * test_sr + 0.5))) +
            abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
              M3_LIFECYCLE_ON_THRESHOLD_OFFSET
            ] - 0.57) +
            abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
              M3_LIFECYCLE_OFF_THRESHOLD_OFFSET
            ] - 0.43);
    m3_lifecycle_response_for_profile(
      M3_PROFILE_MODE_M3,
      0,
      test_sr,
      0.20,
      M3_TEST_LIFECYCLE_RESPONSE_BASE
    );
    error += abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                   M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET
                 ] - max(1, floor(0.024 * test_sr + 0.5))) +
             abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                   M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET
                 ] - max(1, floor(0.024 * test_sr + 0.5))) +
             abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                   M3_LIFECYCLE_ON_THRESHOLD_OFFSET
                 ] - 0.264) +
             abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                   M3_LIFECYCLE_OFF_THRESHOLD_OFFSET
                 ] - 0.20);
    m3_test_near(8101, error, 0, 0.000000000001);
  );

  case_id == 8102 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 60, 0.80, 0.25);
    m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event_count = m3_test_lifecycle_update_default(
      1, attack_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error = abs(event_count - 1) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 60) +
            abs(m3_test_lifecycle_active_count() - 1);
    event_count = m3_test_lifecycle_update_default(
      1, attack_time + test_block_size, event_offset,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += event_count + abs(cleanup_count - 1) +
             m3_test_lifecycle_active_count();
    m3_test_near(8102, error, 0, 0);
  );

  case_id == 8103 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 60, 0.80, 0.25);
    m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event_count = m3_test_lifecycle_update_default(
      1, attack_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 64
    );
    error = abs(event_count - 1);
    m3_zero(
      M3_SELECTION_BASE,
      M3_MAX_VOICES * M3_SELECTION_CELL_SIZE
    );
    event_count = m3_test_lifecycle_update_default(
      0, attack_time + dropout_samples - 1, event_offset,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_test_lifecycle_select(0, 60, 0.80, 0.25);
    event_count += m3_test_lifecycle_update_default(
      1, attack_time + dropout_samples, event_offset,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    error += event_count + abs(m3_test_lifecycle_active_count() - 1);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    m3_test_near(8103, error, 0, 0);
  );

  case_id == 8104 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 60, 0.80, 0.25);
    m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event_count = m3_test_lifecycle_update_default(
      1, attack_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 64
    );
    error = abs(event_count - 1);
    m3_zero(
      M3_SELECTION_BASE,
      M3_MAX_VOICES * M3_SELECTION_CELL_SIZE
    );
    first_loss_time = attack_time + dropout_samples + 1;
    event_count = m3_test_lifecycle_update_default(
      0, first_loss_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 64
    );
    off_time = first_loss_time + release_time;
    event_count += m3_test_lifecycle_update_default(
      0, off_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error += abs(event_count - 1) +
             abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_OFF) +
             abs(event[M3_EVENT_NOTE_OFFSET] - 60) +
             m3_test_lifecycle_active_count();
    event_count = m3_test_lifecycle_update_default(
      0, off_time + test_block_size, event_offset,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    error += event_count;
    m3_test_near(8104, error, 0, 0);
  );

  case_id == 8105 ? (
    m3_test_lifecycle_reset();
    old_cell = M3_VOICE_BASE + 60 * M3_VOICE_CELL_SIZE;
    old_cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_RELEASE;
    old_cell[M3_VOICE_STATE_ENTER_OFFSET] = 0;
    old_cell[M3_VOICE_ACTIVE_OFFSET] = 1;
    new_cell = M3_VOICE_BASE + 61 * M3_VOICE_CELL_SIZE;
    new_cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ATTACK;
    new_cell[M3_VOICE_FIRST_EVIDENCE_OFFSET] = 0;
    new_cell[M3_VOICE_LAST_EVIDENCE_OFFSET] = 0;
    new_cell[M3_VOICE_ENERGY_OFFSET] = 0.25;
    m3_test_lifecycle_select(0, 61, 0.80, 0.25);
    transition_time = max(attack_time, release_time);
    event_count = m3_test_lifecycle_update_default(
      1, transition_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    second_event = m3_test_lifecycle_event(1);
    error = abs(event_count - 2) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_OFF) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 60) +
            abs(event[M3_EVENT_SAMPLE_OFFSET] - event_offset) +
            abs(second_event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(second_event[M3_EVENT_NOTE_OFFSET] - 61) +
            abs(second_event[M3_EVENT_SAMPLE_OFFSET] - event_offset) +
            abs(m3_test_lifecycle_active_count() - 1);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    m3_test_near(8105, error, 0, 0);
  );

  case_id == 8106 ? (
    m3_test_lifecycle_reset();
    index = 0;
    loop(8,
      m3_test_lifecycle_select(index, 40 + index, 0.80, 0.25);
      index += 1;
    );
    m3_test_lifecycle_update_default(
      8, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event_count = m3_test_lifecycle_update_default(
      8, attack_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 64
    );
    error = abs(event_count - 8) +
            abs(m3_test_lifecycle_active_count() - 8);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 8) + m3_test_lifecycle_active_count();
    m3_test_near(8106, error, 0, 0);
  );

  case_id == 8107 ? (
    m3_test_lifecycle_reset();
    index = 0;
    loop(8,
      old_cell = M3_VOICE_BASE + (40 + index) * M3_VOICE_CELL_SIZE;
      old_cell[M3_VOICE_STATE_OFFSET] = M3_LIFECYCLE_STATE_ON;
      old_cell[M3_VOICE_ACTIVE_OFFSET] = 1;
      old_cell[M3_VOICE_VELOCITY_OFFSET] = 64;
      index += 1;
    );
    event_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, event_offset
    );
    error = abs(event_count - 8) + m3_test_lifecycle_active_count();
    index = 0;
    loop(8,
      event = m3_test_lifecycle_event(index);
      error += abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_OFF) +
               abs(event[M3_EVENT_NOTE_OFFSET] - (40 + index));
      index += 1;
    );
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += cleanup_count;
    m3_test_near(8107, error, 0, 0);
  );

  case_id == 8108 ? (
    m3_test_lifecycle_reset();
    event_count = 0;
    index = 0;
    loop(M3_MAX_EVENTS,
      event_count += m3_lifecycle_queue_event(
        M3_EVENT_BASE,
        M3_EVENT_TYPE_ON,
        index,
        64,
        event_offset
      );
      index += 1;
    );
    cleanup_count = m3_lifecycle_queue_event(
      M3_EVENT_BASE,
      M3_EVENT_TYPE_ON,
      100,
      64,
      event_offset
    );
    transition_time = m3_lifecycle_queue_event(
      M3_EVENT_BASE,
      M3_EVENT_TYPE_OFF,
      60,
      0,
      event_offset
    );
    m3_lifecycle_sort_events(M3_EVENT_BASE);
    off_count = m3_test_lifecycle_event_type_count(M3_EVENT_TYPE_OFF);
    on_count = m3_test_lifecycle_event_type_count(M3_EVENT_TYPE_ON);
    event = m3_test_lifecycle_event(0);
    error = abs(event_count - M3_MAX_EVENTS) + cleanup_count +
            abs(transition_time - 1) +
            abs(M3_EVENT_BASE[M3_EVENT_COUNT_OFFSET] - M3_MAX_EVENTS) +
            abs(M3_EVENT_BASE[M3_EVENT_OVERFLOW_OFFSET] - 1) +
            abs(off_count - 1) + abs(on_count - 15) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_OFF) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 60) +
            m3_test_lifecycle_active_count();
    m3_test_near(8108, error, 0, 0);
  );

  case_id == 8109 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 60, 0.70, 0.16);
    m3_test_lifecycle_select(1, 60, 0.90, 0.25);
    m3_test_lifecycle_update_default(
      2, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event_count = m3_test_lifecycle_update_default(
      2, attack_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error = abs(event_count - 1) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 60) +
            abs(m3_test_lifecycle_active_count() - 1);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    m3_test_near(8109, error, 0, 0);
  );

  case_id == 8110 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 60, 0.80, 0.25);
    m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 37
    );
    event_count = m3_test_lifecycle_update_default(
      1, attack_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_FIXED, 37
    );
    event = m3_test_lifecycle_event(0);
    error = abs(event_count - 1) +
            abs(event[M3_EVENT_VELOCITY_OFFSET] - 37);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    m3_test_near(8110, error, 0, 0);
  );

  case_id == 8111 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 60, 0.80, 10 ^ (-60 / 10));
    m3_test_lifecycle_select(1, 61, 0.80, 10 ^ (-6 / 10));
    m3_test_lifecycle_update_default(
      2, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_DYNAMIC, 64
    );
    event_count = m3_test_lifecycle_update_default(
      2, attack_time, event_offset, attack_samples, release_samples,
      dropout_samples, M3_VELOCITY_MODE_DYNAMIC, 64
    );
    event = m3_test_lifecycle_event(0);
    second_event = m3_test_lifecycle_event(1);
    velocity_low = event[M3_EVENT_VELOCITY_OFFSET];
    velocity_high = second_event[M3_EVENT_VELOCITY_OFFSET];
    error = abs(event_count - 2) +
            (velocity_low < 1 || velocity_low > 127 ? 1 : 0) +
            (velocity_high < 1 || velocity_high > 127 ? 1 : 0) +
            (velocity_high <= velocity_low ? 1 : 0);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 2) + m3_test_lifecycle_active_count();
    m3_test_near(8111, error, 0, 0);
  );
);

function m3_test_task_twelve_lifecycle_case(test_sr, test_block_size, case_id)
local(attack_samples, release_samples, short_release_samples, dropout_samples,
      gap_time, loss_time, release_enter_time, checkpoint_time, first_count,
      second_count, third_count, fourth_count, event_count, cleanup_count,
      active_count, event, second_event, cell, error, index, note) (
  m3_lifecycle_response(
    0,
    test_sr,
    0.20,
    M3_TEST_LIFECYCLE_RESPONSE_BASE
  );
  short_release_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
    M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET
  ];
  m3_lifecycle_response_for_profile(
    M3_PROFILE_MODE_M3,
    0,
    test_sr,
    0.20,
    M3_TEST_LIFECYCLE_RESPONSE_BASE
  );
  attack_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
    M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET
  ];
  release_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
    M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET
  ];
  dropout_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
    M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET
  ];

  case_id == 12104 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 47, 0.80, 0.25);
    event_count = m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_zero(
      M3_SELECTION_BASE,
      M3_MAX_VOICES * M3_SELECTION_CELL_SIZE
    );
    gap_time = max(1, floor(dropout_samples / 2));
    event_count += m3_test_lifecycle_update_default(
      0, gap_time, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_test_lifecycle_select(0, 47, 0.80, 0.25);
    event_count += m3_test_lifecycle_update_default(
      1, attack_samples, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error = abs(event_count - 1) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 47) +
            abs(m3_test_lifecycle_active_count() - 1);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    m3_test_near(12104, error, 0, 0);
  );

  case_id == 12105 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 47, 0.80, 0.25);
    m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_zero(
      M3_SELECTION_BASE,
      M3_MAX_VOICES * M3_SELECTION_CELL_SIZE
    );
    gap_time = dropout_samples + 1;
    m3_test_lifecycle_update_default(
      0, gap_time, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_test_lifecycle_select(0, 47, 0.80, 0.25);
    first_count = m3_test_lifecycle_update_default(
      1, attack_samples, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    second_count = m3_test_lifecycle_update_default(
      1, 2 * attack_samples, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error = first_count + abs(second_count - 1) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 47) +
            abs(m3_test_lifecycle_active_count() - 1);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    m3_test_near(12105, error, 0, 0);
  );

  case_id == 12106 ? (
    m3_test_lifecycle_reset();
    m3_test_lifecycle_select(0, 32, 0.80, 0.25);
    m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    first_count = m3_test_lifecycle_update_default(
      1, attack_samples, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_zero(
      M3_SELECTION_BASE,
      M3_MAX_VOICES * M3_SELECTION_CELL_SIZE
    );
    loss_time = attack_samples + dropout_samples + 1;
    m3_test_lifecycle_update_default(
      0, loss_time, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    release_enter_time = attack_samples + dropout_samples;
    checkpoint_time = release_enter_time + short_release_samples;
    second_count = m3_test_lifecycle_update_default(
      0, checkpoint_time, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_test_lifecycle_select(0, 32, 0.80, 0.25);
    event_count = m3_test_lifecycle_update_default(
      1, checkpoint_time + 1, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    cell = M3_VOICE_BASE + 32 * M3_VOICE_CELL_SIZE;
    active_count = m3_test_lifecycle_active_count();
    error = abs(first_count - 1) + second_count + event_count +
            abs(active_count - 1) +
            abs(cell[M3_VOICE_STATE_OFFSET] - M3_LIFECYCLE_STATE_ON);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    m3_test_near(12106, error, 0, 0);
  );

  case_id == 12109 ? (
    m3_lifecycle_response_for_profile(
      M3_PROFILE_MODE_GENERAL,
      0,
      test_sr,
      0.08,
      M3_TEST_LIFECYCLE_RESPONSE_BASE
    );
    error = abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                  M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET
                ] - floor(0.008 * test_sr + 0.5)) +
            abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                  M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET
                ] - floor(0.048 * test_sr + 0.5)) +
            abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                  M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET
                ] - floor(0.024 * test_sr + 0.5)) +
            abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                  M3_LIFECYCLE_ON_THRESHOLD_OFFSET
                ] - 0.2916) +
            abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                  M3_LIFECYCLE_OFF_THRESHOLD_OFFSET
                ] - 0.08);
    m3_lifecycle_response_for_profile(
      M3_PROFILE_MODE_M3,
      0,
      test_sr,
      0.08,
      M3_TEST_LIFECYCLE_RESPONSE_BASE
    );
    error += abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                   M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET
                 ] - floor(0.048 * test_sr + 0.5)) +
             abs(M3_TEST_LIFECYCLE_RESPONSE_BASE[
                   M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET
                 ] - floor(0.024 * test_sr + 0.5));
    m3_test_near(12109, error, 0, 0.000000001);
  );

  case_id == 12110 ? (
    m3_lifecycle_response_for_profile(
      M3_PROFILE_MODE_GENERAL,
      0,
      test_sr,
      0.08,
      M3_TEST_LIFECYCLE_RESPONSE_BASE
    );
    attack_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
      M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET
    ];
    release_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
      M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET
    ];
    dropout_samples = M3_TEST_LIFECYCLE_RESPONSE_BASE[
      M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET
    ];
    m3_test_lifecycle_reset();
    m3_lifecycle_attack_hysteresis = 1;
    m3_test_lifecycle_select(0, 47, 0.35, 0.25);
    first_count = m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    m3_test_lifecycle_select(0, 47, 0.10, 0.25);
    second_count = m3_test_lifecycle_update_default(
      1, attack_samples, 0,
      attack_samples, release_samples, dropout_samples,
      M3_VELOCITY_MODE_FIXED, 64
    );
    event = m3_test_lifecycle_event(0);
    error = first_count + abs(second_count - 1) +
            abs(event[M3_EVENT_TYPE_OFFSET] - M3_EVENT_TYPE_ON) +
            abs(event[M3_EVENT_NOTE_OFFSET] - 47) +
            abs(m3_test_lifecycle_active_count() - 1);
    cleanup_count = m3_lifecycle_release_all(
      M3_VOICE_BASE, M3_EVENT_BASE, 0
    );
    error += abs(cleanup_count - 1) + m3_test_lifecycle_active_count();
    m3_test_near(12110, error, 0, 0);

    m3_test_lifecycle_reset();
    m3_lifecycle_attack_hysteresis = 1;
    m3_lifecycle_attack_bridge_samples = test_block_size;
    m3_test_lifecycle_select(0, 47, 0.35, 0.25);
    first_count = m3_test_lifecycle_update_default(
      1, 0, 0, attack_samples, release_samples, dropout_samples,

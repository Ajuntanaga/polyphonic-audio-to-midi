desc:ajuntanaga/M3 Polyphonic MIDI - MIDI Capture
tags:test MIDI capture analysis
options:gmem=m3_poly_midi_tests_v1
in_pin:left
in_pin:right
out_pin:left
out_pin:right

@init
M3_CAPTURE_COUNTER = 128;
M3_CAPTURE_EVENT_COUNT = 256;
M3_CAPTURE_OVERFLOW = 257;
M3_CAPTURE_EVENT_BASE = 258;
M3_CAPTURE_EVENT_CELL_SIZE = 5;
M3_CAPTURE_MAX_EVENTS = 256;
M3_CAPTURE_DRY_ERROR = 2048;
M3_CAPTURE_DRY_COUNT = 2049;
M3_CAPTURE_OUTPUT_PEAK = 2050;
M3_CAPTURE_NONFINITE = 2051;
M3_CAPTURE_REFERENCE_RING = 4096;
M3_CAPTURE_REFERENCE_CAPACITY = 2048;
M3_CAPABILITY_ACTIVE = 2201;
M3_CAPABILITY_REFERENCE_LEFT = 8192;
M3_CAPABILITY_REFERENCE_RIGHT = 8704;
M3_CAPABILITY_REFERENCE_CAPACITY = 512;
gmem[M3_CAPTURE_OUTPUT_PEAK] = 0;
gmem[M3_CAPTURE_NONFINITE] = 0;

@block
m3_capture_sample_offset = 0;
while(midirecv(
  m3_capture_offset,
  m3_capture_status,
  m3_capture_note,
  m3_capture_velocity
)) (
  m3_capture_message_type = m3_capture_status & 0xF0;
  m3_capture_message_type >= 0x80 &&
  m3_capture_message_type <= 0xE0 ? (
    m3_capture_count = min(
      M3_CAPTURE_MAX_EVENTS,
      max(0, floor(gmem[M3_CAPTURE_EVENT_COUNT]))
    );
    m3_capture_count < M3_CAPTURE_MAX_EVENTS ? (
      m3_capture_cell = M3_CAPTURE_EVENT_BASE +
                        m3_capture_count * M3_CAPTURE_EVENT_CELL_SIZE;
      gmem[m3_capture_cell] = max(
        0,
        floor(gmem[M3_CAPTURE_COUNTER]) - samplesblock +
        floor(m3_capture_offset)
      );
      gmem[m3_capture_cell + 1] = floor(m3_capture_offset);
      gmem[m3_capture_cell + 2] = floor(m3_capture_status);
      gmem[m3_capture_cell + 3] = floor(m3_capture_note);
      gmem[m3_capture_cell + 4] = floor(m3_capture_velocity);
      gmem[M3_CAPTURE_EVENT_COUNT] = m3_capture_count + 1;
    ) : (
      gmem[M3_CAPTURE_OVERFLOW] = 1;
    );
  );
  midisend(
    m3_capture_offset,
    m3_capture_status,
    m3_capture_note,
    m3_capture_velocity
  );
);

@sample
m3_capture_output_peak = max(abs(spl0), abs(spl1));
m3_capture_output_peak == m3_capture_output_peak &&
m3_capture_output_peak < 1000000000000 ? (
  gmem[M3_CAPTURE_OUTPUT_PEAK] = max(
    gmem[M3_CAPTURE_OUTPUT_PEAK],
    m3_capture_output_peak
  );
) : (
  gmem[M3_CAPTURE_NONFINITE] = 1;
);
m3_capture_capacity = gmem[M3_CAPABILITY_ACTIVE] ?
  M3_CAPABILITY_REFERENCE_CAPACITY : M3_CAPTURE_REFERENCE_CAPACITY;
m3_capture_sample_offset < m3_capture_capacity ? (
  gmem[M3_CAPABILITY_ACTIVE] ? (
    m3_capture_reference_left = gmem[
      M3_CAPABILITY_REFERENCE_LEFT + m3_capture_sample_offset
    ];
    m3_capture_reference_right = gmem[
      M3_CAPABILITY_REFERENCE_RIGHT + m3_capture_sample_offset
    ];
  ) : (
    m3_capture_reference_left = gmem[
      M3_CAPTURE_REFERENCE_RING + m3_capture_sample_offset
    ];
    m3_capture_reference_right = m3_capture_reference_left;
  );
  m3_capture_error = max(
    abs(spl0 - m3_capture_reference_left),
    abs(spl1 - m3_capture_reference_right)
  );
  gmem[M3_CAPTURE_DRY_ERROR] = max(
    gmem[M3_CAPTURE_DRY_ERROR],
    m3_capture_error
  );
  gmem[M3_CAPTURE_DRY_COUNT] += 1;
) : (
  gmem[M3_CAPTURE_OVERFLOW] = 1;
);
m3_capture_sample_offset += 1;

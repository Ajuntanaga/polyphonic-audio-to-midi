desc:ajuntanaga/M3 Polyphonic Audio to MIDI
tags:analysis MIDI guitar

import m3_poly_midi/constants.jsfx-inc
import m3_poly_midi/pitch_math.jsfx-inc
import m3_poly_midi/conditioning.jsfx-inc
import m3_poly_midi/resonator_bank.jsfx-inc
import m3_poly_midi/salience_selector.jsfx-inc
import m3_poly_midi/m3_profile.jsfx-inc
import m3_poly_midi/lifecycle.jsfx-inc
import m3_poly_midi/midi_emitter.jsfx-inc
import m3_poly_midi/telemetry_ui.jsfx-inc

in_pin:left
in_pin:right
out_pin:left
out_pin:right

slider1:0<0,2,1{Left,Right,Downmix}>Detector input
slider2:0<0,1,1{M3 Eight-String,General Tonal}>Mode
slider3:440<400,480,0.1>A4 reference (Hz)
slider4:0<-24,24,0.1>Input trim (dB)
slider5:50<0,100,1>Sensitivity
slider6:25<0,100,1>Response (Fast to Stable)
slider7:32<24,108,1>Lowest MIDI note
slider8:84<24,108,1>Highest MIDI note
slider9:8<1,8,1>Maximum polyphony
slider10:24<0,36,1>M3 maximum fret
slider11:1<0,1,1{Fixed,Dynamic}>Velocity mode
slider12:100<1,127,1>Fixed velocity
slider13:1<1,16,1>MIDI channel
slider14:0<0,1,1{Ready,Panic}>Panic
slider15:1<0,1,1{Muted,Pass through}>Dry audio

@init
ext_noinit = 1;
last_srate = 0;
last_play_state = play_state;
slider_profile_mode = -1;

input_mode = 0;
profile_mode = M3_PROFILE_MODE_M3;
a4_reference = 440;
input_trim_gain = 1;
input_trim_target = 1;
input_trim_step = 0;
input_trim_remaining = 0;
sensitivity = 50;
response = 0.25;
detector_min_note = 32;
detector_max_note = 84;
max_polyphony = M3_MAX_VOICES;
profile_max_fret = 24;
velocity_mode = M3_VELOCITY_MODE_DYNAMIC;
fixed_velocity = 100;
midi_channel = 1;
dry_passthrough = 1;

requested_input_mode = input_mode;
requested_profile_mode = profile_mode;
requested_a4_reference = a4_reference;
requested_input_trim_gain = input_trim_target;
requested_sensitivity = sensitivity;
requested_response = response;
requested_min_note = detector_min_note;
requested_max_note = detector_max_note;
requested_max_polyphony = max_polyphony;
requested_profile_max_fret = profile_max_fret;
requested_velocity_mode = velocity_mode;
requested_fixed_velocity = fixed_velocity;
requested_midi_channel = midi_channel;
requested_dry_passthrough = dry_passthrough;

reconfigure_pending = 1;
panic_requested = 0;
panic_hold = 0;
sample_offset = 0;
absolute_sample = 0;
event_count = 0;
emitted_event_count = 0;
saved_schema_version = 1;
host_fault = M3_FAULT_OK;
fault_cleanup_pending = 0;
invalid_input_latched = 0;
event_overflow_latched = 0;
detection_enabled = 0;
block_input_peak = 0;
block_timer_start = 0;
last_commit_ms = 0;
overload_streak = 0;
overload_active = 0;
telemetry_generation = 0;
m3_telemetry_published_base = 0;
ui_ever_drawn = 0;
host_bounds_base = M3_CONFIG_BASE + 88;
lifecycle_response_base = M3_CONFIG_BASE + 96;

m3_profile_load(M3_CONFIG_BASE + M3_PROFILE_OPEN_OFFSET);
m3_lifecycle_init(M3_VOICE_BASE, M3_EVENT_BASE);

@slider
requested_input_mode = floor(m3_clamp(slider1, 0, 2));
requested_profile_mode = floor(m3_clamp(slider2, 0, 1));

requested_profile_mode != slider_profile_mode ? (
  m3_host_apply_bounds(
    requested_profile_mode,
    slider7,
    slider8,
    host_bounds_base
  );
  slider_profile_mode = requested_profile_mode;
) : (
  m3_host_clamp_bounds(slider7, slider8, host_bounds_base);
);

slider1 = requested_input_mode;
slider2 = requested_profile_mode;
slider3 = m3_clamp(slider3, 400, 480);
slider4 = m3_clamp(slider4, -24, 24);
slider5 = floor(m3_clamp(slider5, 0, 100) + 0.5);
slider6 = floor(m3_clamp(slider6, 0, 100) + 0.5);
slider7 = host_bounds_base[M3_HOST_BOUNDS_LOW_OFFSET];
slider8 = host_bounds_base[M3_HOST_BOUNDS_HIGH_OFFSET];
slider9 = floor(m3_clamp(slider9, 1, M3_MAX_VOICES) + 0.5);
slider10 = floor(m3_clamp(slider10, 0, 36) + 0.5);
slider11 = floor(m3_clamp(slider11, 0, 1));
slider12 = floor(m3_clamp(slider12, 1, 127) + 0.5);
slider13 = floor(m3_clamp(slider13, 1, 16) + 0.5);
slider15 = floor(m3_clamp(slider15, 0, 1));

requested_a4_reference = slider3;
requested_input_trim_gain = 10 ^ (slider4 / 20);
requested_sensitivity = slider5;
requested_response = slider6 / 100;
requested_min_note = slider7;
requested_max_note = slider8;
requested_max_polyphony = slider9;
requested_profile_max_fret = slider10;
requested_velocity_mode = slider11;
requested_fixed_velocity = slider12;
requested_midi_channel = slider13;
requested_dry_passthrough = slider15;

hard_configuration_changed =
  requested_input_mode != input_mode ||
  requested_profile_mode != profile_mode ||
  requested_a4_reference != a4_reference ||
  requested_min_note != detector_min_note ||
  requested_max_note != detector_max_note ||
  requested_max_polyphony != max_polyphony ||
  requested_profile_max_fret != profile_max_fret ||
  requested_midi_channel != midi_channel;
hard_configuration_changed ? reconfigure_pending = 1;
panic_requested = panic_requested || slider14 >= 0.5;
slider14 = 0;

@serialize
saved_schema_version = 1;
file_var(0, saved_schema_version);
file_avail(0) >= 0 ? (
  reconfigure_pending = 1;
  panic_requested = 1;
);
saved_schema_version = 1;

@block
corrupt_bounds =
  requested_min_note < 24 || requested_min_note > 108 ||
  requested_max_note < 24 || requested_max_note > 108 ||
  requested_min_note > requested_max_note;
memory_contract_ok = m3_host_memory_contract_ok();
block_fault = m3_host_fault_code(
  num_ch,
  invalid_input_latched,
  corrupt_bounds,
  event_overflow_latched,
  memory_contract_ok
);
block_cleanup_reason = m3_host_cleanup_reason(
  last_srate,
  srate,
  last_play_state,
  play_state,
  reconfigure_pending,
  panic_requested
);
fault_cleanup_reason = block_fault != M3_FAULT_OK && (
  fault_cleanup_pending || block_fault != host_fault
);
panic_hold = m3_host_panic_hold_next(
  panic_hold, panic_requested, block_input_peak
);

(block_cleanup_reason || fault_cleanup_reason) ? (
  cleanup_event_count = m3_midi_panic(M3_VOICE_BASE, midi_channel, 0);
);

input_mode = requested_input_mode;
profile_mode = requested_profile_mode;
a4_reference = requested_a4_reference;
input_trim_target = requested_input_trim_gain;
abs(input_trim_target - input_trim_gain) > 0.000000001 ? (
  input_trim_step = (input_trim_target - input_trim_gain) / 64;
  input_trim_remaining = 64;
);
sensitivity = requested_sensitivity;
response = requested_response;
detector_min_note = requested_min_note;
detector_max_note = requested_max_note;
max_polyphony = requested_max_polyphony;
profile_max_fret = requested_profile_max_fret;
velocity_mode = requested_velocity_mode;
fixed_velocity = requested_fixed_velocity;
midi_channel = requested_midi_channel;
dry_passthrough = requested_dry_passthrough;

(block_cleanup_reason || fault_cleanup_reason) ? (
  m3_host_reset_detector(
    srate,
    detector_min_note,
    detector_max_note,
    a4_reference
  );
  absolute_sample = 0;
  invalid_input_latched = 0;
  event_overflow_latched = 0;
  fault_cleanup_pending = 0;
  reconfigure_pending = 0;
  panic_requested = 0;
);

host_fault = block_fault;
detection_enabled = m3_host_detection_enabled(num_ch, host_fault) &&
                    !panic_hold;
sample_offset = 0;
event_count = 0;
emitted_event_count = 0;
block_input_peak = 0;
m3_lifecycle_reset_events(M3_EVENT_BASE);

detection_enabled ? (
  analysis_signal_present = m3_host_signal_present(
    M3_CONDITION_BASE[10]
  );
  analysis_signal_present ? (
    m3_general_acquisition_samples = min(
      srate,
      m3_general_acquisition_samples + samplesblock
    );
  ) : (
    m3_general_acquisition_samples = 0;
  );
  M3_SALIENCE_BASE[M3_SALIENCE_BASE_THRESHOLD_OFFSET] = m3_clamp(
    0.40 - 0.004 * sensitivity,
    0.05,
    0.40
  );
  M3_SALIENCE_BASE[M3_SALIENCE_CLIPPED_OFFSET] =
    M3_CONDITION_BASE[14] > 0.01;
  m3_salience_update(
    M3_RESONATOR_BASE,
    M3_SALIENCE_BASE,
    M3_CONDITION_BASE[12]
  );
  analysis_signal_present ? (
    selected_voice_local_energy_ratio =
      profile_mode == M3_PROFILE_MODE_M3
      ? M3_SELECTION_M3_LOCAL_ENERGY_RATIO
      : M3_SELECTION_GENERAL_LOCAL_ENERGY_RATIO;
    selected_voice_allow_fundamental_dominance =
      profile_mode == M3_PROFILE_MODE_M3 ? 0 : 1;
    selected_voice_candidate_limit =
      profile_mode == M3_PROFILE_MODE_M3
      ? M3_SELECTION_INTERNAL_CANDIDATES
      : M3_MAX_VOICES;
    selected_voice_count = m3_select_voices(
      M3_RESONATOR_BASE,
      M3_SALIENCE_BASE,
      detector_min_note,
      detector_max_note - detector_min_note + 1,
      M3_SALIENCE_BASE[M3_SALIENCE_EFFECTIVE_THRESHOLD_OFFSET],
      selected_voice_candidate_limit,
      a4_reference,
      selected_voice_local_energy_ratio,
      selected_voice_allow_fundamental_dominance,
      samplesblock,
      srate,
      M3_SELECTION_BASE
    );
    selected_voice_acquisition_seconds =
      profile_mode == M3_PROFILE_MODE_M3
      ? M3_SELECTION_M3_ACQUISITION_SECONDS
      : M3_SELECTION_GENERAL_ACQUISITION_SECONDS;
    general_acquisition_ready =
      m3_general_acquisition_samples >=
        selected_voice_acquisition_seconds * srate;
    !general_acquisition_ready ? (
      selected_voice_count = 0;
      m3_zero(M3_SELECTION_BASE, M3_SELECTION_RESULT_WORDS);
    );
    selected_voice_count = m3_profile_filter_selected(
      profile_mode,
      M3_SELECTION_BASE,
      selected_voice_count,
      max_polyphony,
      profile_max_fret,
      M3_CONFIG_BASE + M3_PROFILE_NOTE_WORK_OFFSET,
      M3_M3_SCRATCH_BASE
    );
  ) : (
    selected_voice_count = 0;
    m3_zero(M3_SELECTION_BASE, M3_SELECTION_RESULT_WORDS);
    m3_zero(
      M3_SALIENCE_BASE + M3_SELECTION_SMOOTHED_ENERGY_OFFSET,
      M3_MAX_CANDIDATES
    );
  );

  m3_lifecycle_attack_admission = analysis_signal_present &&
    m3_lifecycle_attack_admission_allowed(
      M3_CONDITION_BASE[10],
      M3_CONDITION_BASE[11]
    );

  m3_lifecycle_response_for_profile(
    profile_mode,
    response,
    srate,
    M3_SALIENCE_BASE[M3_SALIENCE_EFFECTIVE_THRESHOLD_OFFSET],
    lifecycle_response_base
  );
  m3_lifecycle_attack_hysteresis = 1;
  m3_lifecycle_attack_bridge_samples = 2 * samplesblock;
  m3_lifecycle_attack_evidence_step_samples = samplesblock;
  m3_lifecycle_min_attack_energy = profile_mode == M3_PROFILE_MODE_GENERAL
    ? M3_LIFECYCLE_GENERAL_MIN_ATTACK_ENERGY
    : 0;
  m3_lifecycle_general_octave_guard =
    profile_mode == M3_PROFILE_MODE_GENERAL;
  m3_lifecycle_m3_low_string_guard =
    profile_mode == M3_PROFILE_MODE_M3;
  m3_lifecycle_m3_octave_confirmation =
    profile_mode == M3_PROFILE_MODE_M3;
  m3_lifecycle_m3_low_open_fast_attack =
    profile_mode == M3_PROFILE_MODE_M3;
  m3_lifecycle_reserve_lower_attacks =
    profile_mode == M3_PROFILE_MODE_GENERAL &&
    max_polyphony < M3_MAX_VOICES;
  m3_lifecycle_max_active_voices = max_polyphony;
  event_count = m3_lifecycle_update(
    M3_VOICE_BASE,
    M3_EVENT_BASE,
    M3_SELECTION_BASE,
    selected_voice_count,
    absolute_sample,
    0,
    lifecycle_response_base[M3_LIFECYCLE_ATTACK_SAMPLES_OFFSET],
    lifecycle_response_base[M3_LIFECYCLE_RELEASE_SAMPLES_OFFSET],
    lifecycle_response_base[M3_LIFECYCLE_DROPOUT_SAMPLES_OFFSET],
    lifecycle_response_base[M3_LIFECYCLE_ON_THRESHOLD_OFFSET],
    lifecycle_response_base[M3_LIFECYCLE_OFF_THRESHOLD_OFFSET],
    velocity_mode,
    fixed_velocity
  );

  M3_EVENT_BASE[M3_EVENT_OVERFLOW_OFFSET] ? (
    event_overflow_latched = 1;
    fault_cleanup_pending = 1;
    host_fault = M3_FAULT_EVENT_OVERFLOW;
    detection_enabled = 0;
  );
);

!detection_enabled ? (
  selected_voice_count = 0;
);

last_srate = srate;
last_play_state = play_state;

@sample
sample_offset == 0 ? block_timer_start = time_precise();
detector_in = m3_host_select_input(input_mode, spl0, spl1);
input_is_valid = m3_isfinite(detector_in);
!input_is_valid ? (
  host_fault != M3_FAULT_INVALID_SAMPLES ? (
    fault_cleanup_count = m3_midi_panic(
      M3_VOICE_BASE,
      midi_channel,
      sample_offset
    );
  );
  invalid_input_latched = 1;
  fault_cleanup_pending = 1;
  host_fault = M3_FAULT_INVALID_SAMPLES;
  detection_enabled = 0;
  event_count = 0;
  emitted_event_count = 0;
  detector_in = 0;
);

trimmed_detector_in = detector_in * input_trim_gain;
block_input_peak = max(block_input_peak, abs(trimmed_detector_in));
detection_enabled ? (
  conditioned = m3_condition_process(
    M3_CONDITION_BASE,
    trimmed_detector_in
  );
  m3_bank_process(M3_RESONATOR_BASE, conditioned);
);

input_trim_remaining > 0 ? (
  input_trim_gain += input_trim_step;
  input_trim_remaining -= 1;
  input_trim_remaining <= 0 ? (
    input_trim_gain = input_trim_target;
    input_trim_step = 0;
  );
);

event_i = emitted_event_count;
new_event_count = max(0, event_count - emitted_event_count);
loop(new_event_count,
  m3_midi_emit_event(M3_EVENT_BASE, event_i, midi_channel);
  event_i += 1;
);
emitted_event_count = event_count;

!dry_passthrough ? (
  spl0 = 0;
  spl1 = 0;
);

sample_offset += 1;
absolute_sample += 1;

sample_offset >= max(1, samplesblock) ? (
  block_timer_end = time_precise();
  block_elapsed_seconds = max(0, block_timer_end - block_timer_start);
  last_commit_ms = block_elapsed_seconds * 1000;
  block_deadline_seconds = max(
    0.000001,
    samplesblock / max(1, srate)
  );
  block_elapsed_seconds > 0.50 * block_deadline_seconds
    ? overload_streak += 1
    : overload_streak = 0;
  overload_active = overload_streak >= 3;
  telemetry_write_base =
    m3_telemetry_published_base == M3_TELEMETRY_A_BASE
      ? M3_TELEMETRY_B_BASE
      : M3_TELEMETRY_A_BASE;
  telemetry_generation = m3_telemetry_publish(
    telemetry_write_base,
    telemetry_generation,
    host_fault,
    overload_active,
    block_input_peak,
    M3_CONDITION_BASE[12],
    M3_CONDITION_BASE[14] > 0.01,
    last_commit_ms,
    M3_VOICE_BASE
  );
);

@gfx 520 260
telemetry_read_ok = m3_telemetry_published_base > 0 ? m3_telemetry_read(
  m3_telemetry_published_base,
  M3_UI_LOCAL_BASE
) : 0;
(telemetry_read_ok || !ui_ever_drawn) ? (
  m3_ui_draw(M3_UI_LOCAL_BASE);
  ui_ever_drawn = 1;
);
